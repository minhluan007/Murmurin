{% layout none %}
{% paginate collections by 100 %}
{
  "data": [
    {%- for collection in collections -%}
      {
        "id": {{ collection.id | json }},
        "title": {{ collection.title | json }},
        "handle": {{ collection.handle | json }},
        "products_count": {{ collection.all_products_count | default: collection.products_count | default: 0 }},
        "image": {% if collection.image %}{{ collection.image.src | json }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "page": {{ paginate.current_page }},
  "total_pages": {{ paginate.pages }},
  "total": {{ paginate.pages }}
}
{% endpaginate %}
