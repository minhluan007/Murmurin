{%- assign current_language = cart.attributes.language | default: 'vi' -%}
{%- if current_language == 'en' -%}
  {%- assign article_title = article.title | split: '|' | last -%}
  {%- assign label_prep = 'Prep Time' -%}
  {%- assign label_cook = 'Cook Time' -%}
  {%- assign label_serves = 'Serves' -%}
{%- else -%}
  {%- assign article_title = article.title | split: '|' | first -%}
  {%- assign label_prep = 'Prep Time' -%}
  {%- assign label_cook = 'Cook Time' -%}
  {%- assign label_serves = 'Serves' -%}
{%- endif -%}

{%- assign article_image = '' -%}
{%- if article.image -%}
  {%- assign article_image = article.image.src -%}
{%- elsif article.content contains 'src="' -%}
  {%- assign article_image = article.content | split: 'src="' | last | split: '"' | first -%}
{%- endif -%}

{%- assign article_meta = '' -%}
{%- assign prep_time = '' -%}
{%- assign cook_time = '' -%}
{%- assign serves = '' -%}

{%- for tag in article.tags -%}
  {%- assign tag_down = tag | downcase -%}
  {%- if tag_down contains 'prep' -%}
    {%- assign prep_time = tag | split: ':' | last | strip -%}
  {%- elsif tag_down contains 'cook' -%}
    {%- assign cook_time = tag | split: ':' | last | strip -%}
  {%- elsif tag_down contains 'serve' -%}
    {%- assign serves = tag | split: ':' | last | strip -%}
  {%- endif -%}
{%- endfor -%}

{%- if prep_time != blank or cook_time != blank or serves != blank -%}
  {%- capture article_meta -%}
    {%- if prep_time != blank -%}{{ label_prep }}: {{ prep_time }}{%- endif -%}
    {%- if cook_time != blank -%}{%- if prep_time != blank %} | {% endif -%}{{ label_cook }}: {{ cook_time }}{%- endif -%}
    {%- if serves != blank -%}{%- if prep_time != blank or cook_time != blank %} | {% endif -%}{{ label_serves }}: {{ serves }}{%- endif -%}
  {%- endcapture -%}
{%- elsif article.excerpt != blank -%}
  {%- assign excerpt_text = article.excerpt | strip_html | strip -%}
  {%- assign excerpt_down = excerpt_text | downcase -%}
{%- endif -%}

<section class="article-page">
  <div class="article-page__inner container">
    <h1 class="article-page__title">{{ article_title }}</h1>

    {%- if article_image != blank -%}
      <div class="article-page__media">
        <img
          data-src="{{ article_image }}"
          alt="{{ article_title | escape }}"
          class="lazyload"
          width="1200"
          height="750"
        >
      </div>
    {%- endif -%}

    <div class="article-page__content-inner">
      {%- if article_meta != blank -%}
        <p class="article-page__meta">{{ article_meta | strip }}</p>
      {%- endif -%}

      {%- if article.content != blank -%}
        <div class="article-page__content">
          {{ article.content }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
