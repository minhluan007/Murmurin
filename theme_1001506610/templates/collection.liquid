{%- comment -%}
  Collection page
  Price range defaults — edit data-price-min / data-price-max below (or Theme settings min/max_filter_price)
{%- endcomment -%}
{%- assign price_min_default = settings.min_filter_price | default: 0 -%}
{%- assign price_max_default = settings.max_filter_price | default: 1000000 -%}
{%- if price_max_default == 0 or price_max_default == blank -%}
  {%- assign price_max_default = 1000000 -%}
{%- endif -%}

{%- assign collection_vendors = collection.all_vendors -%}
{%- assign collection_types = collection.all_types -%}

<section
  class="collection-page"
  data-price-min="{{ price_min_default }}"
  data-price-max="{{ price_max_default }}"
>
  <div class="collection-banner">
    <div class="collection-banner__media">
      {%- if collection.image -%}
        <img
          src="{{ collection.image.src }}"
          alt="{{ collection.title | escape }}"
          loading="eager"
        >
      {%- else -%}
        {%- if settings.display_collection_banner -%}
          <img
            src="{{ settings.collection_banner_image }}"
            alt="{{ collection.title | escape }}"
            loading="eager"
          >
        {%- else -%}
          <div class="collection-banner__placeholder"></div>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="collection-banner__content container-fluid">
      <h1 class="collection-banner__title">
        {%- if collection.handle == 'all' -%}
          Tất cả sản phẩm
        {%- else -%}
          {{ collection.title }}
        {%- endif -%}
      </h1>
    </div>
  </div>

  {%- include 'collection-toolbar' -%}

  <div class="collection-body">
    <div class="collection-list render-product">
      {%- for i in (1..10) -%}
        {%- include 'product-loop-no', index: i -%}
      {%- endfor -%}
    </div>
    <div class="pagi-ajax d-none"></div>
  </div>
</section>
