{%- assign home_collection = collections.frontpage -%}
{%- if home_collection.products.size == 0 -%}
  {%- assign home_collection = collections.all -%}
{%- endif -%}

{%- assign home_h1 = settings.title_homepage_hero | default: shop.name | strip -%}
{%- if settings.display_homepage_hero -%}
  <section
    class="home-hero"
    style="
      --width-hero-desktop: {{ settings.width_homepage_hero_desktop }};
      --height-hero-desktop: {{ settings.height_homepage_hero_desktop }};
      --width-hero-mobile: {{ settings.width_homepage_hero_mobile }};
      --height-hero-mobile: {{ settings.height_homepage_hero_mobile }};
    "
  >
    <div class="home-hero__media">
      <picture>
        <source srcset="{{ settings.image_homepage_hero_desktop }}" media="(min-width: 992px)">
        <source srcset="{{ settings.image_homepage_hero_mobile }}" media="(max-width: 991px)">
        <img src="{{ settings.image_homepage_hero_desktop }}" alt="{{ settings.alt_homepage_hero }}" loading="eager">
      </picture>
    </div>
    <div class="home-hero__content container">
      <h1 class="home-hero__title">{{ home_h1 }}</h1>
      {%- if settings.button_text_homepage_hero != blank -%}
        <a
          href="{{ settings.button_link_homepage_hero }}"
          class="home-hero__link"
          title="{{ settings.button_text_homepage_hero }}"
        >
          {{ settings.button_text_homepage_hero }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  <h1 class="visually-hidden">{{ home_h1 }}</h1>
{%- endif -%}

{%- if settings.display_homepage_products -%}
  {%- assign homepageCollection = collections[settings.collection_homepage_products] -%}
  {%- assign limit_homepage_products = settings.limit_homepage_products | default: 6 -%}
  <section
    class="home-products section-collection-1"
    data-collection-id="{{ homepageCollection.id }}"
    data-limit="{{ limit_homepage_products }}"
    data-handle="{{ homepageCollection.handle }}"
    data-url="{{ homepageCollection.url }}"
    data-title="{{ homepageCollection.title }}"
  >
    <div class="home-products__grid">
      {%- for i in (1..6) -%}
        {%- include 'product-loop-no', index: i -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{%- if settings.display_homepage_video -%}
  <section class="home-video">
    <div class="home-video__inner">
      <div
        class="home-video__media"
        data-youtube-id="{{ settings.youtube_id_homepage_video }}"
        style="
          --width-desktop-home-video: {{ settings.width_homepage_video_desktop }};
          --height-desktop-home-video: {{ settings.height_homepage_video_desktop }};
          --width-mobile-home-video: {{ settings.width_homepage_video_mobile }};
          --height-mobile-home-video: {{ settings.height_homepage_video_mobile }};
        "
      >
        <picture>
          <source srcset="{{ settings.image_homepage_video_poster }}" media="(min-width: 992px)">
          <source srcset="{{ settings.image_homepage_video_poster_mobile }}" media="(max-width: 991px)">
          <img
            data-src="{{ settings.image_homepage_video_poster }}"
            alt="{{ settings.alt_homepage_video_poster }}"
            class="home-video__poster lazyload"
          >
        </picture>
        {%- if settings.youtube_id_homepage_video -%}
          <button type="button" class="home-video__play" aria-label="Play video">
            <svg width="24" height="28" viewBox="0 0 24 28" fill="none" aria-hidden="true">
              <path d="M2 2L22 14L2 26V2Z" fill="currentColor"/>
            </svg>
          </button>
        {%- endif -%}
        <div class="home-video__iframe-wrap"></div>
      </div>
      <div class="home-video__content">
        <h2 class="home-video__title">{{ settings.title_homepage_video }}</h2>
        <div class="home-video__text">
          <p>{{ settings.description_homepage_video }}</p>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}
