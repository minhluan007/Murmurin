<script>
  window.dataProduct = {{ product | json }};
</script>

<section class="product-detail">
  <div class="product-detail__main">
    <div class="product-detail__gallery js-product-gallery"></div>

    <div class="product-detail__info">
      <h1 class="product-detail__title js-product-title">{{ product.title }}</h1>

      <div class="product-detail__price-wrap">
        <span class="product-detail__price js-product-price"></span>
        <span class="product-detail__price-discount js-product-price-discount d-none">
          <del></del>
          <label></label>
        </span>
      </div>

      <div class="product-detail__desc js-product-desc"></div>

      <div class="product-detail__options">
        <div class="product-detail__option product-detail__option--1 d-none" data-option-index="1">
          <div class="product-detail__option-label js-option-label-1"></div>
          <div class="product-detail__swatches js-option-1"></div>
        </div>
        <div class="product-detail__option product-detail__option--2 d-none" data-option-index="2">
          <div class="product-detail__option-label js-option-label-2"></div>
          <div class="product-detail__swatches js-option-2"></div>
        </div>
        <div class="product-detail__option product-detail__option--3 d-none" data-option-index="3">
          <div class="product-detail__option-label js-option-label-3"></div>
          <div class="product-detail__swatches js-option-3"></div>
        </div>
      </div>

      <div class="product-detail__actions">
        <div class="product-detail__qty">
          <button type="button" class="product-detail__qty-btn js-qty-minus" aria-label="Giảm số lượng">−</button>
          <input
            type="number"
            class="product-detail__qty-input js-qty-input"
            value="1"
            min="1"
            inputmode="numeric"
            aria-label="Số lượng"
          >
          <button type="button" class="product-detail__qty-btn js-qty-plus" aria-label="Tăng số lượng">+</button>
        </div>
        <button type="button" class="product-detail__add-cart js-add-cart">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.608 9.421V6.906H3.392v8.016c0 .567.224 1.112.624 1.513.4.402.941.627 1.506.627H8.63M8.818 3h2.333c.618 0 1.212.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.344c0-.622.246-1.218.683-1.658A2.33 2.33 0 0 1 8.82 3"></path>
            <path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="M14.608 12.563v5m2.5-2.5h-5"></path>
          </svg>
          <span>Thêm vào giỏ</span>
        </button>
      </div>

      <button type="button" class="product-detail__buy-now js-buy-now">Mua ngay</button>

      <select id="product-select" class="product-detail__select d-none" aria-hidden="true">
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant == product.selected_or_first_available_variant %}
              selected
            {% endif %}
            {% unless variant.available %}
              disabled
            {% endunless %}
          >
            {{ variant.title }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  </div>

  <div class="product-detail__related">
    <div class="product-detail__related-list js-product-related">
      {%- for i in (1..10) -%}
        {%- include 'product-loop-no', index: i -%}
      {%- endfor -%}
    </div>
  </div>
</section>
