{%- assign current_language = cart.attributes.language | default: 'vi' -%}
{%- if current_language == 'en' -%}
  {%- assign blog_read_more = 'Read more...' -%}
  {%- assign blog_empty = 'No articles in this blog yet.' -%}
  {%- assign blog_title = blog.title | split: '|' | last -%}
{%- else -%}
  {%- assign blog_read_more = 'Xem thêm...' -%}
  {%- assign blog_empty = 'Chưa có bài viết nào trong mục này' -%}
  {%- assign blog_title = blog.title | split: '|' | first -%}
{%- endif -%}

<section class="blog-page">
  <div class="blog-page__inner container">
    <h1 class="blog-page__title">{{ blog_title }}</h1>

    {% paginate blog.articles by 6 %}
      {%- if blog.articles.size == 0 -%}
        <p class="blog-page__empty">{{ blog_empty }}</p>
      {%- else -%}
        <div class="blog-page__list">
          {%- for article in blog.articles -%}
            {%- assign article_image = '' -%}
            {%- if article.image -%}
              {%- assign article_image = article.image.src -%}
            {%- elsif article.excerpt contains 'src="' -%}
              {%- assign article_image = article.excerpt | split: 'src="' | last | split: '"' | first -%}
            {%- endif -%}

            {%- if current_language == 'en' -%}
              {%- assign article_title = article.title | split: '|' | last -%}
            {%- else -%}
              {%- assign article_title = article.title | split: '|' | first -%}
            {%- endif -%}

            {%- if article.excerpt != blank -%}
              {%- assign article_excerpt = article.excerpt | strip_html | strip | truncatewords: 28 -%}
            {%- else -%}
              {%- assign article_excerpt = article.content | strip_html | strip | truncatewords: 28 -%}
            {%- endif -%}

            {%- if forloop.first -%}
              <article class="blog-card blog-card--featured">
                <a class="blog-card__media" href="{{ article.url }}" title="{{ article_title | escape }}">
                  {%- if article_image != blank -%}
                    <img
                      data-src="{{ article_image }}"
                      alt="{{ article_title | escape }}"
                      class="lazyload"
                      width="1200"
                      height="750"
                    >
                  {%- else -%}
                    <span class="blog-card__placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </a>
                <div class="blog-card__content">
                  <h2 class="blog-card__title">
                    <a href="{{ article.url }}" title="{{ article_title | escape }}">{{ article_title }}</a>
                  </h2>
                  {%- if article_excerpt != blank -%}
                    <p class="blog-card__excerpt">{{ article_excerpt }}</p>
                  {%- endif -%}
                  <a class="blog-card__more" href="{{ article.url }}" title="{{ article_title | escape }}">
                    {{- blog_read_more -}}
                  </a>
                </div>
              </article>
            {%- else -%}
              {%- if forloop.index == 2 -%}
                <div class="blog-page__grid blog-page__grid--2">
              {%- endif -%}
              {%- if forloop.index == 4 -%}
                <div class="blog-page__grid blog-page__grid--3">
              {%- endif -%}

              <article class="blog-card">
                <a class="blog-card__media" href="{{ article.url }}" title="{{ article_title | escape }}">
                  {%- if article_image != blank -%}
                    <img
                      data-src="{{ article_image }}"
                      alt="{{ article_title | escape }}"
                      class="lazyload"
                      width="800"
                      height="560"
                    >
                  {%- else -%}
                    <span class="blog-card__placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </a>
                <div class="blog-card__content">
                  <h2 class="blog-card__title">
                    <a href="{{ article.url }}" title="{{ article_title | escape }}">{{ article_title }}</a>
                  </h2>
                  {%- if article_excerpt != blank -%}
                    <p class="blog-card__excerpt">{{ article_excerpt }}</p>
                  {%- endif -%}
                  <a class="blog-card__more" href="{{ article.url }}" title="{{ article_title | escape }}">
                    {{- blog_read_more -}}
                  </a>
                </div>
              </article>

              {%- if forloop.index == 3 -%}
                </div>
              {%- endif -%}
              {%- if forloop.index == 2 and forloop.last -%}
                </div>
              {%- endif -%}
              {%- if forloop.index >= 4 and forloop.last -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div class="blog-page__pagination">
          {% include 'pagination-default' %}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>
