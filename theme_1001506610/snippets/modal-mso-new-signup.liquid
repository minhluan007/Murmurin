<div
  id="modal-mso-new-signup"
  class="mso-signup"
  style="display: none;"
  data-lang="{{ language }}"
  data-processing="{{ btn_processing }}"
>
  <div class="mso-signup__inner">
    <div class="mso-signup__tabs">
      <button type="button" class="mso-signup__tab mso-signup__tab--active" data-tab="login">{{ tab_login }}</button>
      <button type="button" class="mso-signup__tab" data-tab="register">{{ tab_register }}</button>
    </div>

    <div class="mso-signup__body">
      <div class="mso-signup__panel mso-signup__panel--login is-active" data-panel="login">
        {% comment %} <p class="mso-signup__intro">{{ login_note }}</p> {% endcomment %}
        <form id="mso-form-login" class="mso-signup__form" novalidate>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-login-email">{{ label_email }}</label>
            <input
              id="mso-login-email"
              class="mso-signup__input"
              type="email"
              name="email"
              placeholder="{{ placeholder_email }}"
              autocomplete="email"
            />
            <span class="mso-signup__error" data-error-for="email"></span>
          </div>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-login-password">{{ label_password }}</label>
            <div class="mso-signup__password">
              <input
                id="mso-login-password"
                class="mso-signup__input"
                type="password"
                name="password"
                placeholder="{{ placeholder_password }}"
                autocomplete="current-password"
              />
              <span class="mso-signup__eye" role="button" tabindex="0" aria-label="Toggle password">
                {{ icon_eye_off }}
                {{ icon_eye_on }}
              </span>
            </div>
            <span class="mso-signup__error" data-error-for="password"></span>
          </div>
          <div class="mso-signup__actions">
            <div class="mso-signup__status"></div>
            <button type="submit" class="mso-signup__submit" data-default-text="{{ btn_login }}">
              {{ btn_login }}
            </button>
            <a href="javascript:void(0);" class="mso-signup__forgot-link">{{ link_forgot }}</a>
          </div>
        </form>
      </div>

      <div class="mso-signup__panel mso-signup__panel--register" data-panel="register">
        {% comment %} <div class="mso-signup__benefits">{{ register_benefits }}</div> {% endcomment %}
        <form id="mso-form-register" class="mso-signup__form" novalidate>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-register-lastname">{{ label_last_name }}</label>
            <input
              id="mso-register-lastname"
              class="mso-signup__input"
              type="text"
              name="last_name"
              placeholder="{{ placeholder_last_name }}"
              autocomplete="family-name"
            />
            <span class="mso-signup__error" data-error-for="last_name"></span>
          </div>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-register-firstname">{{ label_first_name }}</label>
            <input
              id="mso-register-firstname"
              class="mso-signup__input"
              type="text"
              name="first_name"
              placeholder="{{ placeholder_first_name }}"
              autocomplete="given-name"
            />
            <span class="mso-signup__error" data-error-for="first_name"></span>
          </div>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-register-email">{{ label_email }}</label>
            <input
              id="mso-register-email"
              class="mso-signup__input"
              type="email"
              name="email"
              placeholder="{{ placeholder_email }}"
              autocomplete="email"
            />
            <span class="mso-signup__error" data-error-for="email"></span>
          </div>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-register-password">{{ label_password }}</label>
            <div class="mso-signup__password">
              <input
                id="mso-register-password"
                class="mso-signup__input"
                type="password"
                name="password"
                placeholder="{{ placeholder_password }}"
                autocomplete="new-password"
              />
              <span class="mso-signup__eye" role="button" tabindex="0" aria-label="Toggle password">
                {{ icon_eye_off }}
                {{ icon_eye_on }}
              </span>
            </div>
            <span class="mso-signup__error" data-error-for="password"></span>
            <p class="mso-signup__hint">{{ password_hint }}</p>
          </div>
          <p class="mso-signup__terms">{{ terms_text }}</p>
          <div class="mso-signup__actions">
            <div class="mso-signup__status"></div>
            <button type="submit" class="mso-signup__submit" data-default-text="{{ btn_register }}">
              {{ btn_register }}
            </button>
            <a href="javascript:void(0);" class="mso-signup__forgot-link">{{ link_forgot }}</a>
          </div>
        </form>
      </div>

      <div class="mso-signup__panel mso-signup__panel--forgot" data-panel="forgot">
        <p class="mso-signup__intro">{{ forgot_note }}</p>
        <form id="mso-form-forgot" class="mso-signup__form" novalidate>
          <div class="mso-signup__field">
            <label class="mso-signup__label" for="mso-forgot-email">{{ label_email }}</label>
            <input
              id="mso-forgot-email"
              class="mso-signup__input"
              type="email"
              name="email"
              placeholder="{{ placeholder_email }}"
              autocomplete="email"
            />
            <span class="mso-signup__error" data-error-for="email"></span>
          </div>
          <div class="mso-signup__actions">
            <div class="mso-signup__status"></div>
            <button type="submit" class="mso-signup__submit" data-default-text="{{ btn_forgot }}">
              {{ btn_forgot }}
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="mso-signup__divider"></div>

    <div class="mso-signup__social">
      <button type="button" class="mso-signup__social-btn mso-signup__social-btn--google" id="btn-google-login">
        <span class="mso-signup__social-icon">{{ icon_google }}</span>
        <span>{{ social_google }}</span>
      </button>
      <button type="button" class="mso-signup__social-btn mso-signup__social-btn--facebook" id="btn-facebook-login">
        <span class="mso-signup__social-icon">{{ icon_facebook }}</span>
        <span>{{ social_facebook }}</span>
      </button>
    </div>
  </div>
</div>
