    {%- assign tab_login = 'LOGIN' -%}
    {%- assign tab_register = 'REGISTER' -%}
    {%- assign label_email = 'EMAIL' -%}
    {%- assign label_password = 'PASSWORD' -%}
    {%- assign label_last_name = 'LAST NAME' -%}
    {%- assign label_first_name = 'FIRST NAME' -%}
    {%- assign placeholder_email = 'Enter Email' -%}
    {%- assign placeholder_password = 'Enter password' -%}
    {%- assign placeholder_last_name = 'Enter your last name' -%}
    {%- assign placeholder_first_name = 'Enter your first name' -%}
    {%- assign btn_login = 'LOGIN' -%}
    {%- assign btn_register = 'CREATE ACCOUNT' -%}
    {%- assign btn_forgot = 'VERIFY EMAIL' -%}
    {%- assign btn_processing = 'Processing...' -%}
    {%- assign link_forgot = 'FORGOT PASSWORD?' -%}
    {%- assign social_google = 'LOGIN WITH GOOGLE' -%}
    {%- assign social_facebook = 'LOGIN WITH FACEBOOK' -%}
    {%- assign login_note = 'Sign in to check out faster and enjoy <strong><a href="/pages/chuong-trinh-khach-hang-than-thiet">membership privileges</a></strong>' -%}
    {%- assign forgot_note = 'Please enter your email here to receive password reset instructions.' -%}
    {%- assign password_hint = 'Password must be at least 8 characters, including letters and numbers, no special characters' -%}
    {%- capture terms_text -%}
  	By creating an account at {{ shop.name }}, you agree to the <a href="/pages/chinh-sach-bao-mat-thong-tin" target="_blank">Privacy Policy</a> and <a href="/pages/dieu-khoan-dieu-kien" target="_blank">Terms & Conditions</a>
  	{%- endcapture -%}
  {%- endif -%}
{% endcomment %}

