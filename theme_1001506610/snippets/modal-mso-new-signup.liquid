{%- assign label_password = 'MẬT KHẨU' -%}
{%- assign label_last_name = 'HỌ' -%}
{%- assign label_first_name = 'TÊN' -%}
{%- assign placeholder_email = 'Nhập Email' -%}
{%- assign placeholder_password = 'Nhập mật khẩu' -%}
{%- assign placeholder_last_name = 'Nhập họ của bạn' -%}
{%- assign placeholder_first_name = 'Nhập tên của bạn' -%}
{%- assign btn_login = 'ĐĂNG NHẬP' -%}
{%- assign btn_register = 'TẠO TÀI KHOẢN' -%}
{%- assign btn_forgot = 'XÁC THỰC EMAIL' -%}
