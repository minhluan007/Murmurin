{%- assign main_menu = linklists[settings.main_menu] -%}

<div class="menu-mobile" aria-hidden="true">
  <div class="menu-mobile__overlay"></div>

  <div class="menu-mobile__drawer">
    <button type="button" class="menu-mobile__close" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <nav class="menu-mobile__nav" aria-label="Mobile navigation">
      <ul class="menu-mobile__list">
        {%- if main_menu.links.size > 0 -%}
          {%- for link in main_menu.links -%}
            {%- assign child_menu = linklists[link.handle] -%}
            <li
              class="
                menu-mobile__item
                {%- if child_menu.links.size > 0 %} menu-mobile__item--has-sub{% endif -%}
              "
            >
              <a
                href="{{ link.url }}"
                title="{{ link.title }}"
                {% if link.active %}
                  class="is-active"
                {% endif %}
              >
                {{- link.title | upcase -}}
              </a>
              {%- if child_menu.links.size > 0 -%}
                <ul class="menu-mobile__sub">
                  {%- for child in child_menu.links -%}
                    <li>
                      <a
                        href="{{ child.url }}"
                        title="{{ child.title }}"
                        {% if child.active %}
                          class="is-active"
                        {% endif %}
                      >
                        {{- child.title | upcase -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    {%- if settings.use_banner_card_1_1 or settings.use_banner_card_2_1 -%}
      <div class="menu-mobile__banners">
        {%- if settings.use_banner_card_1_1 and settings.image_banner_card_1_1 != blank -%}
          <a
            class="menu-mobile__promo"
            href="{{ settings.link_banner_card_1_1 | default: '/collections/all' }}"
            title="{{ settings.title_banner_card_1_1 | default: 'All products' }}"
          >
            <img
              src="{{ settings.image_banner_card_1_1 }}"
              alt="{{ settings.alt_banner_card_1_1 | default: settings.title_banner_card_1_1 }}"
              loading="lazy"
            >
            <span>{{ settings.title_banner_card_1_1 | default: 'ALL PRODUCTS' | upcase }}</span>
          </a>
        {%- endif -%}

        {%- if settings.use_banner_card_2_1 and settings.image_banner_card_2_1 != blank -%}
          <a
            class="menu-mobile__promo"
            href="{{ settings.link_banner_card_2_1 | default: '/collections/all' }}"
            title="{{ settings.title_banner_card_2_1 | default: 'All products' }}"
          >
            <img
              src="{{ settings.image_banner_card_2_1 }}"
              alt="{{ settings.alt_banner_card_2_1 | default: settings.title_banner_card_2_1 }}"
              loading="lazy"
            >
            <span>{{ settings.title_banner_card_2_1 | default: 'ALL PRODUCTS' | upcase }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
