<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__columns">
      <div class="site-footer__links-group">
        <div class="site-footer__col">
          <h3 class="site-footer__heading">SHOP</h3>
          <ul class="site-footer__links">
            {%- if linklists['footer-shop'].links.size > 0 -%}
              {%- for link in linklists['footer-shop'].links -%}
                <li>
                  <a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/collections/all" title="All Products">All Products</a></li>
              <li><a href="/collections/barbecue" title="Barbecue">Barbecue</a></li>
              <li><a href="/collections/hot-sauce" title="Hot Sauce">Hot Sauce</a></li>
              <li><a href="/collections/marinades" title="Marinades">Marinades</a></li>
            {%- endif -%}
          </ul>
        </div>

        <div class="site-footer__col">
          <h3 class="site-footer__heading">ASK</h3>
          <ul class="site-footer__links">
            {%- if linklists['footer-ask'].links.size > 0 -%}
              {%- for link in linklists['footer-ask'].links -%}
                <li>
                  <a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/shipping" title="Shipping">Shipping</a></li>
              <li><a href="/pages/returns" title="Returns">Returns</a></li>
              <li><a href="/pages/faq" title="FAQ">FAQ</a></li>
              <li><a href="/pages/contact" title="Contact">Contact</a></li>
            {%- endif -%}
          </ul>
        </div>

        <div class="site-footer__col">
          <h3 class="site-footer__heading">CONNECT</h3>
          <ul class="site-footer__links">
            {%- if linklists['footer-connect'].links.size > 0 -%}
              {%- for link in linklists['footer-connect'].links -%}
                <li>
                  <a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="https://instagram.com" target="_blank" rel="noopener" title="Instagram">Instagram</a></li>
              <li><a href="https://facebook.com" target="_blank" rel="noopener" title="Facebook">Facebook</a></li>
              <li><a href="https://pinterest.com" target="_blank" rel="noopener" title="Pinterest">Pinterest</a></li>
              <li><a href="https://tiktok.com" target="_blank" rel="noopener" title="TikTok">TikTok</a></li>
            {%- endif -%}
          </ul>
        </div>
      </div>

      <div class="site-footer__col site-footer__col--newsletter">
        <h3 class="site-footer__heading">WE SEND TASTY EMAILS</h3>
        <form
          action="/account/register"
          method="post"
          class="site-footer__newsletter"
          accept-charset="UTF-8"
          id="footer-newsletter-form"
        >
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="footer-newsletter-email">Email address</label>
          <input
            type="email"
            id="footer-newsletter-email"
            name="contact[email]"
            placeholder="Email address"
            autocomplete="email"
            required
          >
          <button type="submit" aria-label="Subscribe">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. Powered by Haravan
      </p>
    </div>
  </div>
</footer>
