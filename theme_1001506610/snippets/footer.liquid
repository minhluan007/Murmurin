<footer class="site-footer">
  <div class="site-footer__inner container">
    <div class="site-footer__columns">
      <div class="site-footer__links-group">
        {%- for i in (1..3) -%}
          {%- capture title_col -%}title_col_footer_{{ i }}{%- endcapture -%}
          {%- capture links_col -%}links_col_footer_{{ i }}{%- endcapture -%}
          {%- assign getSettings = settings[links_col] -%}
          <div class="site-footer__col">
            <h3 class="site-footer__heading">{{ settings[title_col] }}</h3>
            <ul class="site-footer__links">
              {%- for link in linklists[getSettings].links -%}
                <li>
                  <a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
      {%- if settings.display_footer_newsletter -%}
        <div class="site-footer__col site-footer__col--newsletter">
          <h3 class="site-footer__heading">{{ settings.title_footer_newsletter }}</h3>
          <form
            class="site-footer__newsletter"
            id="footer-newsletter-form"
          >
            <input
              type="email"
              id="footer-newsletter-email"
              name="contact[email]"
              placeholder="Email address"
              autocomplete="email"
              required
            >
            <div class="status-message d-none"></div>
            <button type="submit" aria-label="Subscribe">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </form>
        </div>
      {%- endif -%}
    </div>
    <div class="site-footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}
      </p>
    </div>
  </div>
</footer>
