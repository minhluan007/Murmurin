{%- if template contains 'customers' -%}
  {{ 'haravan_common.js' | haravan_asset_url | script_tag }}
  {{ 'customer_area.js' | haravan_asset_url | script_tag }}
{%- endif -%}
<script>
  window.varibleCollection = {};
  window.filterPrice = {
    min: {% if settings.min_filter_price %}{{ settings.min_filter_price }}{% else %}0{% endif %},
    max: {% if settings.max_filter_price and settings.max_filter_price != 0 %}{{ settings.max_filter_price }}{% else %}1000000{% endif %}
  }
</script>
{%- if template contains 'collection' -%}
  <script>
    window.varibleCollection = {
    	id: "{{ collection.id }}",
    	title: {{ collection.title | json }},
    	handle: "{{ collection.handle }}",
    	defaultSortBy: "{{collection.default_sort_by}}",
      totalProduct: "{{ collection.all_products_count }}",
      limit: 20
    }
  </script>
{%- endif -%}
{%- if template contains 'search' -%}
  <script>
    window.varibleCollection = {
      terms: '{{ search.terms }}',
      totalProduct: '{{ search.results_count }}',
      limit: 20,
    };
  </script>
{%- endif -%}
{%- comment -%} main.js already preloaded in master-include; load after DOM ready via data-src {%- endcomment -%}
<script type="text/javascript" data-src="{{ 'main.js' | asset_url }}"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var jsquery = document.querySelectorAll('script[data-src]');
    for (var i = 0; i < jsquery.length; i++) {
      var src_ = jsquery[i].getAttribute('data-src');
      if (!src_) continue;
      var script = document.createElement('script');
      script.async = true;
      script.src = src_;
      document.head.appendChild(script);
    }
  });
</script>
