<script >
	window.insider_object = window.insider_object || {};
	var phone = '{{ customer.phone }}';
	if(phone != null && phone != '' && phone != undefined){
		var getFirst = phone.substr(0,1);
		if(getFirst == '0'){
			phone = '+84' + phone.substring(1);
		}
	}
	var firstNameData = '{% if customer.first_name %}{{ customer.first_name | downcase }}{% else %}{{ customer.default_address.first_name | downcase }}{% endif %}';
	var lastNameData = '{% if customer.last_name %}{{ customer.last_name | downcase }}{% else %}{{ customer.default_address.last_name | downcase }}{% endif %}';
	window.user_data = {
		sha256_email_address: Sha256.hash('{{ customer.email }}'),
		sha256_phone_number: Sha256.hash(phone),
		email_address: '{{ customer.email }}',
		phone_number: phone,
		address: {
			first_name: encodeURI(firstNameData),
			last_name: encodeURI(lastNameData),
			city: '{{ customer.default_address.province | downcase }}',
			country: 'VN',
		},
	};
</script>

