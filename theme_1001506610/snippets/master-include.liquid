<link rel="preconnect" href="https://file.hstatic.net" />
<link rel="preconnect" href="https://product.hstatic.net" />
<link rel="preconnect" href="https://theme.hstatic.net" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{%- include 'fb-open-graph-tags' -%}

{%- comment -%} Google Fonts in head (avoid CSS @import late discovery); only weights actually used {%- endcomment -%}
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
>

{%- comment -%} Critical CSS: preload + apply in one link {%- endcomment -%}
<link
  rel="preload stylesheet"
  as="style"
  href="{{ 'plugin-css-head.css' | asset_url }}"
  type="text/css"
>
<link
  rel="preload stylesheet"
  as="style"
  href="{{ 'styles.scss.css' | asset_url }}"
  type="text/css"
>

{%- comment -%} Preload JS used via data-src (discovered late) so browser fetches early {%- endcomment -%}
<link
  fetchpriority="high"
  href="{{ 'plugins-jquery.js' | asset_url }}"
  rel="preload"
  as="script"
>
<link
  fetchpriority="low"
  href="{{ 'plugin-script.js' | asset_url }}"
  rel="preload"
  as="script"
>
<link
  fetchpriority="low"
  href="{{ 'jquery.fancybox.min.js' | asset_url }}"
  rel="preload"
  as="script"
>
<link
  fetchpriority="low"
  href="{{ 'api.jquery.js' | haravan_asset_url }}"
  rel="preload"
  as="script"
>
<link
  fetchpriority="low"
  href="{{ 'main.js' | asset_url }}"
  rel="preload"
  as="script"
>

<script type="text/javascript" src="{{ 'plugins-jquery.js' | asset_url }}"></script>
<script type="text/javascript" data-src="{{ 'plugin-script.js' | asset_url }}"></script>
<script type="text/javascript" data-src="{{ 'jquery.fancybox.min.js' | asset_url }}"></script>
<script type="text/javascript" data-src="{{ 'api.jquery.js' | haravan_asset_url }}"></script>

<script data-src="https://www.google.com/recaptcha/api.js?render=6LchSLkqAAAAABVHBpeFgg8N-WgkYsr5fO6GUF_s"></script>

<script>
   var formatMoney = "{{ shop.money_format }}";
   window.dataProduct = {};
  window.shop = {
     language: localStorage.getItem('language'),
  	url: '{{ shop.url }}',
  	id: '{{ shop.id }}',
  	template: "{{ template }}",
  	moneyFormat: "{{ shop.money_format }}",
    name: "{{ shop.name }}",
  	account: {
  		id: '{{ customer.id }}',
  		email: '{{ customer.email }}',
  		logged: {% if customer %}true{% else %}false{% endif %},
  		birthday: '{{ customer.birthday | date: "%d/%m/%Y" }}',
  		gender: '{% if customer.gender == 1 %}Nam{% elsif customer.gender == 0 %}Nữ{% else %}Không xác định{% endif %}',
  		tags: '{{ customer.tags | join: "," }}',
  		phone: '{{ customer.phone }}',
  		marketing: '{{ customer.accepts_marketing }}',
  	}
  }
</script>
<style>
  :root {
    --font-heading: 'Barlow Condensed', sans-serif;
    --font-body: 'Inter', sans-serif;
    --color-mega-menu-underline: {{ settings.color_mega_menu_underline | default: '#7b0c0c' }};
    --color-mini-cart-accent: {{ settings.color_mini_cart_accent | default: '#a50d25' }};
    --color-mini-cart-accent-hover: {{ settings.color_mini_cart_accent_hover | default: '#8a0b1f' }};
    --color-mini-search-view-all-hover: {{ settings.color_mini_search_view_all_hover | default: '#a50d25' }};
    --color-collection-accent: {{ settings.color_collection_accent | default: '#8a0b1f' }};
    --color-product-accent: {{ settings.color_product_accent | default: '#8a0b1f' }};
    --color-product-accent-dark: {{ settings.color_product_accent_dark | default: '#6e0918' }};
    --color-product-accent-light: {{ settings.color_product_accent_light | default: '#a31228' }};
    --color-blog-accent: {{ settings.color_blog_accent | default: '#8a0b1f' }};
    --color-article-accent: {{ settings.color_article_accent | default: '#8a0b1f' }};
    --color-contact-accent-dark: {{ settings.color_contact_accent_dark | default: '#a50d25' }};
  }
</style>
<script>
  window.lang = {
    t1: 'Không có sản phẩm nào',
    t2: 'Đăng ký nhận thông tin thành công',
    t3: 'Đăng ký nhận thông tin thất bại',
    t4: 'Thông báo',
    t5: 'Không tìm thấy kết quả',
  };
</script>
