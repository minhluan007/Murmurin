<div class="site-header-holder">
  <div class="site-header-sticky{% if template == 'index' or template == 'collection' or template == 'product' %} site-header-sticky--overlay{% endif %}">
    {%- if settings.display_topbar -%}
      <div
        class="site-header__topbar"
        style="--background-topbar: {{ settings.background_topbar }}; --color-topbar: {{ settings.color_topbar }};"
      >
        <div class="swiper topbar-swiper">
          <div class="swiper-wrapper">
            {%- for i in (1..3) -%}
              {%- capture use -%}use_item_topbar_{{ i }}{%- endcapture -%}
              {%- if settings[use] -%}
                {%- capture title -%}title_item_topbar_{{ i }}{%- endcapture -%}
                {%- capture link -%}link_item_topbar_{{ i }}{%- endcapture -%}
                <div class="swiper-slide">
                  <a href="{{ settings[link] }}" title="{{ settings[title] }}">
                    {{ settings[title] }}
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <header
      class="
        site-header
        {%- if template == 'product' %} site-header--dark{% endif %}
        {%- if template == 'index' or template == 'collection' or template == 'product' %} site-header--overlay{% endif %}
      "
    >
      {%- assign main_menu = linklists[settings.main_menu] -%}
      {%- assign current_language = cart.attributes.language | default: 'vi' -%}

      <div class="site-header__backdrop" aria-hidden="true"></div>

      <div class="site-header__wrap">
        <div class="site-header__bar container-fluid">
          <div class="site-header__bar-left">
            <button type="button" class="site-header__toggle" aria-label="Open menu" aria-expanded="false">
              <span></span>
              <span></span>
            </button>
            <a
              href="/search"
              class="site-header__action site-header__action--search-mb js-open-mini-search"
              title="Search"
              aria-label="Search"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
          </div>

          <div class="site-header__logo">
            <a
              href="/"
              title="{{ shop.name }}"
            >
              <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">
            </a>
          </div>

          <nav class="site-header__nav" aria-label="Main navigation">
            <ul class="site-header__menu">
              {%- if main_menu.links.size > 0 -%}
                {%- for link in main_menu.links -%}
                  {%- assign child_menu = linklists[link.handle] -%}
                  {%- if child_menu.links.size > 0 -%}
                    <li class="site-header__item site-header__item--dropdown" data-mega="{{ link.handle }}">
                      <a
                        href="{{- link.url -}}"
                        title="{{ link.title }}"
                        {% if link.active %}
                          class="is-active"
                        {% endif %}
                      >
                        {{- link.title -}}
                      </a>
                    </li>
                  {%- else -%}
                    <li class="site-header__item">
                      <a
                        href="{{ link.url }}"
                        title="{{ link.title }}"
                        {% if link.active %}
                          class="is-active"
                        {% endif %}
                      >
                        {{- link.title -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>

          <div class="site-header__actions">
            <a
              href="/search"
              class="site-header__action site-header__action--search-dk js-open-mini-search"
              title="Search"
              aria-label="Search"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle
                cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/> <path d="M20 20L16.5 16.5" stroke="currentColor"
                stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </a>
            <a
              href="{%- if customer %}/account{% else %}/account/login{% endif -%}"
              class="site-header__action js-open-modal-mso-new-signup"
              title="Account"
              aria-label="Account"
            >
              <svg
                width="20"
                height="20"
                viewBox="
                  0 0 24
                  24
                "
                fill="none"
                aria-hidden="true"
              >
                <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/> <path
                d="M5 20C5 16.134 8.134 13 12 13C15.866 13 19 16.134 19 20" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round"/>
              </svg>
            </a>
            <a
              href="/cart"
              class="site-header__action site-header__action--cart js-open-mini-cart"
              title="Cart"
              aria-label="Cart"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6H21L19 14H8L6 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/> <path d="M6 6L5
                3H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/> <circle cx="9.5" cy="18.5" r="1.5"
                fill="currentColor"/> <circle cx="17.5" cy="18.5" r="1.5" fill="currentColor"/>
              </svg>
              <span
                class="site-header__cart-count"
                {% if cart.item_count == 0 %}
                  style="display:none"
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
            </a>

            <div class="site-header__lang">
              <button
                type="button"
                class="site-header__lang-toggle"
                aria-expanded="false"
                aria-label="Change language"
              >
                <span class="site-header__lang-label">VN/EN</span>
                <svg
                  class="site-header__lang-chevron"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                  stroke-linejoin="round"/>
                </svg>
              </button>

              <div class="site-header__lang-dropdown">
                <ul>
                  <li>
                    <a
                      href="#"
                      class="
                        site-header__lang-option
                        {%- if current_language != 'en' %} is-active{% endif -%}
                      "
                      data-lang="vi"
                      title="Tiếng Việt"
                    >
                      <span class="site-header__lang-flag" aria-hidden="true">
                        <svg
                          version="1.1"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 512 512"
                        >
                          <polygon style="fill:#ff1d35;" points="196.641,85.337
                          0,85.337 0,426.663 196.641,426.663 512,426.663 512,85.337"></polygon> <polygon style="fill:#FFDA44;"
                          points="256,157.279 278.663,227.026 352,227.026 292.668,270.132 315.332,339.881 256,296.774 196.668,339.881
                          219.332,270.132 160,227.026 233.337,227.026"></polygon>
                        </svg>
                      </span>
                      <span class="site-header__lang-text">Tiếng Việt</span>
                    </a>
                  </li>
                  <li>
                    <a
                      href="#"
                      class="
                        site-header__lang-option
                        {%- if current_language == 'en' %} is-active{% endif -%}
                      "
                      data-lang="en"
                      title="English"
                    >
                      <span class="site-header__lang-flag" aria-hidden="true">
                        <svg
                          version="1.1"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 512 512"
                        >
                          <rect y="85.333" style="fill:#F0F0F0;" width="512"
                          height="341.337"></rect> <polygon style="fill:#D80027;" points="288,85.33 224,85.33 224,223.996 0,223.996
                          0,287.996 224,287.996 224,426.662 288,426.662 288,287.996 512,287.996 512,223.996 288,223.996"></polygon> <g>
                          <polygon style="fill:#0052B4;" points="393.785,315.358 512,381.034 512,315.358"></polygon> <polygon
                          style="fill:#0052B4;" points="311.652,315.358 512,426.662 512,395.188 368.307,315.358"></polygon> <polygon
                          style="fill:#0052B4;" points="458.634,426.662 311.652,344.998 311.652,426.662"></polygon> </g> <polygon
                          style="fill:#F0F0F0;" points="311.652,315.358 512,426.662 512,395.188 368.307,315.358"></polygon> <polygon
                          style="fill:#D80027;" points="311.652,315.358 512,426.662 512,395.188 368.307,315.358"></polygon> <g> <polygon
                          style="fill:#0052B4;" points="90.341,315.356 0,365.546 0,315.356"></polygon> <polygon style="fill:#0052B4;"
                          points="200.348,329.51 200.348,426.661 25.491,426.661"></polygon> </g> <polygon style="fill:#D80027;"
                          points="143.693,315.358 0,395.188 0,426.662 0,426.662 200.348,315.358"></polygon> <g> <polygon
                          style="fill:#0052B4;" points="118.215,196.634 0,130.958 0,196.634"></polygon> <polygon style="fill:#0052B4;"
                          points="200.348,196.634 0,85.33 0,116.804 143.693,196.634"></polygon> <polygon style="fill:#0052B4;"
                          points="53.366,85.33 200.348,166.994 200.348,85.33"></polygon> </g> <polygon style="fill:#F0F0F0;"
                          points="200.348,196.634 0,85.33 0,116.804 143.693,196.634"></polygon> <polygon style="fill:#D80027;"
                          points="200.348,196.634 0,85.33 0,116.804 143.693,196.634"></polygon> <g> <polygon style="fill:#0052B4;"
                          points="421.659,196.636 512,146.446 512,196.636"></polygon> <polygon style="fill:#0052B4;" points="311.652,182.482
                          311.652,85.331 486.509,85.331"></polygon> </g> <polygon style="fill:#D80027;" points="368.307,196.634 512,116.804
                          512,85.33 512,85.33 311.652,196.634"></polygon>
                        </svg>
                      </span>
                      <span class="site-header__lang-text">English</span>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="site-header__mega-wrap">
          {%- if main_menu.links.size > 0 -%}
            {%- for link in main_menu.links -%}
              {%- assign getIndex = forloop.index -%}
              {%- assign child_menu = linklists[link.handle] -%}
              {%- if child_menu.links.size > 0 -%}
                <div class="site-header__mega" data-mega="{{ link.handle }}">
                  <div
                    class="
                      site-header__mega-inner
                      container-fluid
                    "
                  >
                    <div class="site-header__mega-links">
                      <ul>
                        {%- for child in child_menu.links -%}
                          <li>
                            <a href="{{ child.url }}" title="{{ child.title }}">{{ child.title | upcase }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>

                    {%- capture use_banner_cards -%}use_banner_cards_{{ getIndex }}{%- endcapture -%}
                    {%- if settings[use_banner_cards] -%}
                      <div class="site-header__mega-cards">
                        {%- for i in (1..2) -%}
                          {%- capture use_banner_card -%}use_banner_card_{{ i }}_{{ getIndex }}{%- endcapture -%}
                          {%- if settings[use_banner_card] -%}
                            {%- capture title -%}title_banner_card_{{ i }}_{{ getIndex }}{%- endcapture -%}
                            {%- capture link -%}link_banner_card_{{ i }}_{{ getIndex }}{%- endcapture -%}
                            {%- capture image -%}image_banner_card_{{ i }}_{{ getIndex }}{%- endcapture -%}
                            {%- capture alt -%}alt_banner_card_{{ i }}_{{ getIndex }}{%- endcapture -%}
                            <a
                              class="site-header__mega-card"
                              href="{{ settings[link] }}"
                              title="{{ settings[title] }}"
                            >
                              <img src="{{ settings[image] }}" alt="{{ settings[alt] }}" loading="lazy">
                              <span>{{ settings[title] }}</span>
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- include 'menu-mobile' -%}
    </header>
  </div>
</div>
