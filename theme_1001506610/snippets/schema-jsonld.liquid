{%- comment -%}
  JSON-LD structured data for Google (Organization, WebSite, Product, Article, Collection, Breadcrumb)
  Optional fields (description, image, sku…) chỉ render khi có dữ liệu.
{%- endcomment -%}

{%- assign schema_logo = 'logo.png' | asset_url -%}
{%- if schema_logo contains '//' -%}
  {%- unless schema_logo contains 'http' -%}
    {%- assign schema_logo = 'https:' | append: schema_logo -%}
  {%- endunless -%}
{%- else -%}
  {%- assign schema_logo = shop.url | append: schema_logo -%}
{%- endif -%}

{%- assign schema_desc = '' -%}
{%- if page_description != blank -%}
  {%- assign schema_desc = page_description | strip_html | strip_newlines | strip -%}
{%- elsif settings.page_description != blank -%}
  {%- assign schema_desc = settings.page_description | strip_html | strip_newlines | strip -%}
{%- endif -%}

{%- comment -%} Organization + WebSite (sitewide) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ schema_logo | json }}
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}#website",
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": {
        "@id": "{{ shop.url }}#organization"
      },
      "inLanguage": "vi-VN",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>

{%- if template == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ shop.url }}/#webpage",
  "url": {{ shop.url | json }},
  "name": {{ shop.name | json }}
  {%- if schema_desc != blank -%}
  ,"description": {{ schema_desc | json }}
  {%- endif -%}
  ,"isPartOf": {
    "@id": "{{ shop.url }}#website"
  },
  "about": {
    "@id": "{{ shop.url }}#organization"
  }
}
</script>
{%- endif -%}

{%- if template contains 'product' and product -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign schema_price = product.price | money_without_currency | remove: ',' | remove: '.' | remove: '₫' | remove: ' ' | strip -%}
  {%- if product.available -%}
    {%- assign schema_availability = 'https://schema.org/InStock' -%}
  {%- else -%}
    {%- assign schema_availability = 'https://schema.org/OutOfStock' -%}
  {%- endif -%}

  {%- assign schema_product_image = '' -%}
  {%- if product.featured_image -%}
    {%- assign schema_product_image = product.featured_image.src | product_img_url: 'grande' | remove: 'http:' | remove: 'https:' -%}
    {%- assign schema_product_image = 'https:' | append: schema_product_image -%}
  {%- endif -%}

  {%- assign schema_product_desc = '' -%}
  {%- if product.description != blank -%}
    {%- assign schema_product_desc = product.description | strip_html | strip_newlines | strip | truncate: 5000 -%}
  {%- elsif product.content != blank -%}
    {%- assign schema_product_desc = product.content | strip_html | strip_newlines | strip | truncate: 5000 -%}
  {%- endif -%}

  {%- assign schema_sku = '' -%}
  {%- if current_variant.sku != blank -%}
    {%- assign schema_sku = current_variant.sku -%}
  {%- elsif product.id != blank -%}
    {%- assign schema_sku = product.id -%}
  {%- endif -%}

  {%- assign schema_brand = shop.name -%}
  {%- if product.vendor != blank -%}
    {%- assign schema_brand = product.vendor -%}
  {%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }}
  {%- if schema_product_desc != blank -%}
  ,"description": {{ schema_product_desc | json }}
  {%- endif -%}
  {%- if schema_product_image != blank -%}
  ,"image": [
    {{ schema_product_image | json }}
  ]
  {%- endif -%}
  {%- if schema_sku != blank -%}
  ,"sku": {{ schema_sku | json }}
  {%- endif -%}
  ,"brand": {
    "@type": "Brand",
    "name": {{ schema_brand | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": {{ shop.currency | json }}
    {%- if schema_price != blank -%}
    ,"price": {{ schema_price | json }}
    {%- endif -%}
    ,"availability": {{ schema_availability | json }},
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": {{ shop.url | json }}
    }
    {%- if collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ shop.url | append: collection.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ canonical_url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- if template contains 'collection' and collection and template != 'list-collections' -%}
  {%- assign schema_collection_desc = '' -%}
  {%- if collection.description != blank -%}
    {%- assign schema_collection_desc = collection.description | strip_html | strip_newlines | strip | truncate: 5000 -%}
  {%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }}
  {%- if schema_collection_desc != blank -%}
  ,"description": {{ schema_collection_desc | json }}
  {%- endif -%}
  ,"url": {{ canonical_url | json }},
  "isPartOf": {
    "@id": "{{ shop.url }}#website"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}

{%- if template contains 'article' and article -%}
  {%- assign schema_article_title = article.title | split: '|' | first | strip -%}
  {%- assign schema_article_desc = '' -%}
  {%- if article.excerpt != blank -%}
    {%- assign schema_article_desc = article.excerpt | strip_html | strip_newlines | strip | truncate: 5000 -%}
  {%- elsif article.content != blank -%}
    {%- assign schema_article_desc = article.content | strip_html | strip_newlines | strip | truncate: 5000 -%}
  {%- endif -%}
  {%- assign schema_article_image = '' -%}
  {%- if article.image -%}
    {%- assign schema_article_image = article.image.src -%}
  {%- elsif article.content contains 'src="' -%}
    {%- assign schema_article_image = article.content | split: 'src="' | last | split: '"' | first -%}
  {%- endif -%}
  {%- if schema_article_image != blank -%}
    {%- unless schema_article_image contains 'http' -%}
      {%- assign schema_article_image = 'https:' | append: schema_article_image -%}
    {%- endunless -%}
  {%- endif -%}
  {%- assign schema_article_author = shop.name -%}
  {%- if article.author != blank -%}
    {%- assign schema_article_author = article.author -%}
  {%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ schema_article_title | json }}
  {%- if schema_article_desc != blank -%}
  ,"description": {{ schema_article_desc | json }}
  {%- endif -%}
  {%- if schema_article_image != blank -%}
  ,"image": [
    {{ schema_article_image | json }}
  ]
  {%- endif -%}
  {%- if article.published_at != blank -%}
  ,"datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
  {%- endif -%}
  {%- if article.updated_at != blank -%}
  ,"dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
  {%- elsif article.published_at != blank -%}
  ,"dateModified": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }}
  {%- endif -%}
  ,"author": {
    "@type": "Person",
    "name": {{ schema_article_author | json }}
  },
  "publisher": {
    "@id": "{{ shop.url }}#organization"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  },
  "url": {{ canonical_url | json }}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | split: '|' | first | strip | json }},
      "item": {{ shop.url | append: blog.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ schema_article_title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}

{%- if template contains 'blog' and blog and template != 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ blog.title | split: '|' | first | strip | json }},
  "url": {{ canonical_url | json }},
  "publisher": {
    "@id": "{{ shop.url }}#organization"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | split: '|' | first | strip | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}

{%- if template contains 'page' and page -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ page.title | json }}
  {%- if schema_desc != blank -%}
  ,"description": {{ schema_desc | json }}
  {%- endif -%}
  ,"url": {{ canonical_url | json }},
  "isPartOf": {
    "@id": "{{ shop.url }}#website"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ page.title | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
{%- endif -%}
