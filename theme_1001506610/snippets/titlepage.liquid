
<title>
	{%- assign language = cart.attributes.language -%}
	{%- assign getPageTitle = page_title -%}
	
	{%- if template contains 'article' -%}
		{%- assign getPageTitle = article.title | split: '|' | first -%}
	{%- endif -%}
	
	{%- if language == 'en' -%}
	
		{%- if template contains 'article' -%}
			{%- assign getPageTitle = article.title | split: '|' | last -%}
		{%- endif -%}
	
		{%- if template contains 'page' -%}
			{%- assign getTitlePageEN = page.metafields.hrvmultilang_en.title | append: '' -%}
			{%- if getTitlePageEN != '' -%}
				{%- assign getPageTitle = getTitlePageEN | append: ' - MAMMA GELATO' -%}
			{%- endif -%}
		{%- endif -%}
	
		{%- if template contains 'collection' -%}
			{%- assign getTitlePageEN = collection.metafields.hrvmultilang_en.title | append: '' -%}
			{%- if getTitlePageEN != '' -%}
				{%- assign getPageTitle = getTitlePageEN | append: ' - MAMMA GELATO' -%}
			{%- endif -%}
		{%- endif -%}
	
		{%- if template contains 'product' -%}
			{%- assign getTitlePageEN = product.metafields.hrvmultilang_en.title | append: '' -%}
			{%- if getTitlePageEN != '' -%}
				{%- assign getPageTitle = getTitlePageEN | append: ' - MAMMA GELATO' -%}
			{%- else -%}
				{%- assign getPageTitle = product.title | append: ' - MAMMA GELATO' -%}
			{%- endif -%}
		{%- endif -%}
	
	{%- else -%}
	
		{%- if template contains 'product' -%}
			{%- assign getPageTitle = product.title -%}
		{%- endif -%}
	
	{%- endif -%}
	
	{%- capture defaultTitle -%}
		{{ getPageTitle }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %} - MAMMA GELATO
	{%- endcapture -%}


	{%- if template contains 'index' -%}
	
		{%- if language == 'en' -%}
			MAMMA GELATO
		{%- else -%}
			MAMMA GELATO
		{%- endif -%}
	
	{%- else -%}
	
		{%- if language == 'en' -%}
			{%- if template contains 'cart' -%}
				Cart - MAMMA GELATO
			{%- elsif template contains 'search' -%}
				Search - MAMMA GELATO
			{%- elsif template contains 'login' -%}
				Login - MAMMA GELATO
			{%- elsif template contains 'register' -%}
				Register - MAMMA GELATO
			{%- elsif template contains 'wishlist' -%}
				Wishlist - MAMMA GELATO
			{%- elsif template contains 'addresses' -%}
				Addresses - MAMMA GELATO
			{%- elsif template contains 'orders' -%}
				Orders - MAMMA GELATO
			{%- elsif template contains 'order' -%}
				Detail Order - MAMMA GELATO
			{%- elsif template contains 'account' -%}
				Account - MAMMA GELATO
			{%- else -%}
				{{defaultTitle}}
			{%- endif -%}
		{%- else -%}
			{{defaultTitle}}
		{%- endif -%}
	
	{%- endif -%}
</title>