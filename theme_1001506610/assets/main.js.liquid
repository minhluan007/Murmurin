MLPRO.Header = {
  init: function () {
    this.topbarSwiper();
    this.stickyHeader();
    this.megaMenu();
    this.mobileToggle();
    this.languageSwitch();
  },
  topbarSwiper: function () {
    var $topbar = $('.topbar-swiper');
    if (!$topbar.length || typeof Swiper === 'undefined') {
      return;
    }
    new Swiper('.topbar-swiper', {
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false
      },
      speed: 700,
      effect: 'slide',
      allowTouchMove: true
    });
  },
  stickyHeader: function () {
    var $holder = $('.site-header-holder');
    var $sticky = $('.site-header-sticky');
    var threshold = 10;

    if (!$holder.length || !$sticky.length) {
      return;
    }

    function syncHolderHeight() {
      var scrollTop = $(window).scrollTop() || 0;
      var isOverlay = $sticky.hasClass('site-header-sticky--overlay');
      var isFixed = $sticky.hasClass('is-fixed');

      if (isOverlay && scrollTop <= threshold) {
        $holder.css('height', 0);
        return;
      }

      if (isFixed) {
        $holder.css('height', $sticky.outerHeight());
        return;
      }

      $holder.css('height', '');
    }

    function updateStickyState() {
      var scrollTop = $(window).scrollTop() || 0;
      var isOverlay = $sticky.hasClass('site-header-sticky--overlay');

      if (isOverlay && scrollTop <= threshold) {
        $sticky.removeClass('is-fixed is-scrolled');
        $holder.css('height', 0);
        return;
      }

      if (!isOverlay && scrollTop <= threshold) {
        $sticky.removeClass('is-fixed is-scrolled');
        $holder.css('height', '');
        return;
      }

      $sticky.addClass('is-fixed is-scrolled');
      $holder.css('height', $sticky.outerHeight());
    }

    MLPRO.Header.syncHolderHeight = syncHolderHeight;

    updateStickyState();
    $(window).on('scroll.headerSticky resize.headerSticky', function () {
      updateStickyState();
    });
  },
  megaMenu: function () {
    var $header = $('.site-header');
    var $dropdownItem = $header.find('.site-header__item--dropdown');
    var $mega = $header.find('.site-header__mega');
    var closeTimer;

    if (!$dropdownItem.length || !$mega.length) {
      return;
    }

    function openMega(megaId) {
      clearTimeout(closeTimer);
      $header.addClass('is-mega-open');
      $dropdownItem.removeClass('is-active');
      $mega.removeClass('is-active');
      $dropdownItem.filter('[data-mega="' + megaId + '"]').addClass('is-active');
      $mega.filter('[data-mega="' + megaId + '"]').addClass('is-active');
      if (typeof MLPRO.Header.syncHolderHeight === 'function') {
        setTimeout(MLPRO.Header.syncHolderHeight, 50);
      }
    }

    function closeMega() {
      closeTimer = setTimeout(function () {
        $header.removeClass('is-mega-open');
        $dropdownItem.removeClass('is-active');
        $mega.removeClass('is-active');
        if (typeof MLPRO.Header.syncHolderHeight === 'function') {
          setTimeout(MLPRO.Header.syncHolderHeight, 480);
        }
      }, 80);
    }

    $dropdownItem.on('mouseenter focusin', function () {
      openMega($(this).data('mega'));
    });

    $mega.on('mouseenter', function () {
      openMega($(this).data('mega'));
    });

    $header.on('mouseleave', closeMega);

    $dropdownItem.on('focusout', function (e) {
      if (!$header[0].contains(e.relatedTarget)) {
        closeMega();
      }
    });
  },
  mobileToggle: function () {
    var $toggle = $('.site-header__toggle');
    var $menuMobile = $('.menu-mobile');
    var $drawer = $menuMobile.find('.menu-mobile__drawer');
    var $overlay = $menuMobile.find('.menu-mobile__overlay');
    var $close = $menuMobile.find('.menu-mobile__close');
    var closeTimer;

    if (!$toggle.length || !$menuMobile.length) {
      return;
    }

    function finishClose() {
      if (!$menuMobile.hasClass('is-open')) {
        $menuMobile.removeClass('is-visible').attr('aria-hidden', 'true');
      }
    }

    function openMenu() {
      clearTimeout(closeTimer);
      $menuMobile.addClass('is-visible').attr('aria-hidden', 'false');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          $menuMobile.addClass('is-open');
        });
      });
      $toggle.attr('aria-expanded', 'true');
      $('body').addClass('open-menu-mb');
    }

    function closeMenu() {
      if (!$menuMobile.hasClass('is-open')) {
        return;
      }

      $menuMobile.removeClass('is-open');
      $toggle.attr('aria-expanded', 'false');
      $('body').removeClass('open-menu-mb');

      clearTimeout(closeTimer);
      closeTimer = setTimeout(finishClose, 420);
    }

    $drawer.on('transitionend', function (e) {
      if (e.target !== this || e.originalEvent.propertyName !== 'transform') {
        return;
      }
      clearTimeout(closeTimer);
      finishClose();
    });

    $toggle.on('click', function () {
      if ($menuMobile.hasClass('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    $close.on('click', closeMenu);
    $overlay.on('click', closeMenu);

    $(document).on('keydown.menuMobile', function (e) {
      if (e.key === 'Escape' && $menuMobile.hasClass('is-open')) {
        closeMenu();
      }
    });
  },
  languageSwitch: function () {
    var $lang = $('.site-header__lang');
    var $options = $('.site-header__lang-option');

    $options.on('click', function (e) {
      e.preventDefault();
      var lang = $(this).data('lang');
      var currentLang = localStorage.getItem('language') || 'vi';

      if (!lang || lang === currentLang) {
        return;
      }

      localStorage.setItem('language', lang);

      $.ajax({
        type: 'POST',
        url: '/cart/update.js',
        dataType: 'json',
        data: {
          attributes: {
            language: lang
          }
        },
        success: function () {
          window.location.reload();
        },
        error: function () {
          window.location.reload();
        }
      });
    });

    $lang.on('mouseenter', function () {
      $(this).addClass('is-open').find('.site-header__lang-toggle').attr('aria-expanded', true);
    });

    $lang.on('mouseleave', function () {
      $(this).removeClass('is-open').find('.site-header__lang-toggle').attr('aria-expanded', false);
    });
  }
}
