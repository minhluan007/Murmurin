MLPRO.MiniSearch = {
  allCollections: [],
  collectionThumbs: {},
  swipers: {},
  typingTimer: null,
  doneTypingInterval: 250,
  currentKeyword: '',
  isOpen: false,
  init: function () {
    var self = this;
    if (!$('#mini-search').length) {
      return;
    }
    self.bindOpen();
    self.bindForm();
    self.bindClear();
  },
  labels: function () {
    var $el = $('#mini-search');
    return {
      products: $el.data('label-products') || 'Products',
      collections: $el.data('label-collections') || 'Collections',
      blogs: $el.data('label-blogs') || 'Blog',
      suggest: $el.data('label-suggest') || 'Suggested collections',
      productsCount: $el.data('label-products-count') || 'products',
      noResult: $el.data('label-no-result') || 'No results found',
      viewAll: $el.data('label-view-all') || 'View all',
    };
  },
  bindOpen: function () {
    var self = this;
    $(document).on('click', '.js-open-mini-search', function (e) {
      e.preventDefault();
      self.open();
    });
  },
  bindForm: function () {
    var self = this;
    var $input = $('#mini-search .mini-search__input');

    $('#mini-search .mini-search__form').on('submit', function (e) {
      e.preventDefault();
      var key = $.trim($input.val());
      if (key) {
        location.href = '/search?q=' + encodeURIComponent(key);
      }
    });

    $input.on('keyup', function () {
      clearTimeout(self.typingTimer);
      self.toggleClear();
      self.typingTimer = setTimeout(function () {
        self.onSearch();
      }, self.doneTypingInterval);
    });

    $input.on('keydown', function () {
      clearTimeout(self.typingTimer);
    });
  },
  bindClear: function () {
    var self = this;
    $('#mini-search .mini-search__clear').on('click', function () {
      var $input = $('#mini-search .mini-search__input');
      $input.val('');
      self.toggleClear();
      self.currentKeyword = '';
      self.showSuggest();
      $input.focus();
    });
  },
  toggleClear: function () {
    var hasValue = $.trim($('#mini-search .mini-search__input').val()) !== '';
    $('#mini-search .mini-search__clear').prop('hidden', !hasValue);
  },
  open: function () {
    var self = this;
    var $modal = $('#mini-search');

    if (!$modal.length || typeof $.fancybox === 'undefined') {
      return;
    }

    if (self.isOpen) {
      return;
    }

    $.fancybox.open({
      src: $modal[0],
      type: 'inline',
      touch: false,
      smallBtn: false,
      toolbar: false,
      animationEffect: 'fade',
      transitionEffect: 'fade',
      baseClass: 'fancybox-mini-search-wrap',
      beforeShow: function () {
        self.isOpen = true;
        $modal.attr('aria-hidden', 'false');
      },
      afterShow: function () {
        var $input = $modal.find('.mini-search__input');
        $input.focus();
        self.toggleClear();
        if ($.trim($input.val()) === '') {
          self.showSuggest();
        } else {
          self.onSearch();
        }
      },
      afterClose: function () {
        self.isOpen = false;
        $modal.attr('aria-hidden', 'true');
        self.destroySwipers();
      },
    });
  },
  close: function () {
    if (typeof $.fancybox !== 'undefined') {
      $.fancybox.close();
    }
  },
  addLoading: function () {
    $('#mini-search').addClass('is-loading');
  },
  removeLoading: function () {
    $('#mini-search').removeClass('is-loading');
  },
  onSearch: function () {
    var self = this;
    var keyword = $.trim($('#mini-search .mini-search__input').val());
    self.currentKeyword = keyword;

    if (!keyword) {
      self.showSuggest();
      return;
    }

    self.addLoading();
    self.query(keyword);
  },
  searchRequest: function (post, callback) {
    $.ajax({
      type: 'POST',
      url: '/search.js',
      data: post,
      success: function (response) {
        if (typeof callback === 'function') {
          callback(response);
        }
      },
      error: function () {
        if (typeof callback === 'function') {
          callback(null);
        }
      },
    });
  },
  showSuggest: function () {
    var self = this;
    var labels = self.labels();
    var handle = $('#mini-search').data('suggest-collection') || 'fe-test';

    $('#mini-search .mini-search__section--collections').addClass('is-hidden');
    $('#mini-search .mini-search__section--blogs').addClass('is-hidden');
    $('#mini-search .mini-search__footer').addClass('is-hidden');
    $('#mini-search .wrap-collections').empty();
    $('#mini-search .wrap-blogs').empty();

    $('#mini-search .mini-search__section-title').first().text(labels.suggest);

    self.addLoading();
    $.ajax({
      url: '/collections/' + handle + '/products.json?page=1&limit=4',
      success: function (response) {
        if (self.currentKeyword) {
          self.removeLoading();
          return;
        }

        if (response && response.products && response.products.length) {
          var products = response.products.map(function (product) {
            var item = Object.assign({}, product);
            item.url = '/products/' + item.handle;
            if (item.image && item.image.src) {
              item.featured_image = item.image.src;
            } else if (item.images && item.images.length && item.images[0].src) {
              item.featured_image = item.images[0].src;
            }
            if (item.variants && item.variants.length) {
              item.price = Number(item.variants[0].price) * 100;
            }
            return item;
          });
          $('#mini-search .wrap-product').html(self.htmlProduct({ products: products }));
        } else {
          $('#mini-search .wrap-product').html(
            '<div class="mini-search__empty">' + labels.noResult + '</div>'
          );
        }
        $('#mini-search .mini-search__section--products').removeClass('is-hidden');
        self.removeLoading();
      },
      error: function () {
        if (self.currentKeyword) {
          self.removeLoading();
          return;
        }
        $('#mini-search .wrap-product').html(
          '<div class="mini-search__empty">' + labels.noResult + '</div>'
        );
        $('#mini-search .mini-search__section--products').removeClass('is-hidden');
        self.removeLoading();
      },
    });
  },
  ensureCollections: function (callback) {
    var self = this;
    if (self.allCollections.length) {
      if (typeof callback === 'function') {
        callback();
      }
      return;
    }
    self.loadCollections(callback);
  },
  loadCollections: async function (callback) {
    var self = this;
    try {
      self.allCollections = [];
      var firstRes = await fetch('/collections?page=1');
      var firstData = await firstRes.json();
      if (firstData.data && Array.isArray(firstData.data)) {
        self.allCollections = self.allCollections.concat(firstData.data);
      }
      var totalPages = parseInt(firstData.total_pages || firstData.total, 10) || 1;
      if (totalPages > 1) {
        var requests = [];
        for (var i = 2; i <= totalPages; i++) {
          requests.push(fetch('/collections?page=' + i).then(function (res) {
            return res.json();
          }));
        }
        var pages = await Promise.all(requests);
        pages.forEach(function (res) {
          if (res.data && Array.isArray(res.data)) {
            self.allCollections = self.allCollections.concat(res.data);
          }
        });
      }
      if (typeof callback === 'function') {
        callback();
      }
    } catch (err) {
      console.error('MiniSearch loadCollections error:', err);
      if (typeof callback === 'function') {
        callback();
      }
    }
  },
  getCollectionThumbs: function (handle, callback) {
    var self = this;
    if (self.collectionThumbs[handle]) {
      callback(self.collectionThumbs[handle]);
      return;
    }
    $.ajax({
      url: '/collections/' + handle + '/products.json?page=1&limit=4',
      success: function (response) {
        var thumbs = [];
        if (response && response.products && response.products.length) {
          response.products.forEach(function (product) {
            var src = null;
            if (product.image && product.image.src) {
              src = product.image.src;
            } else if (product.images && product.images.length && product.images[0].src) {
              src = product.images[0].src;
            }
            if (src) {
              thumbs.push(Haravan.resizeImage(src, 'small'));
            }
          });
        }
        self.collectionThumbs[handle] = thumbs;
        callback(thumbs);
      },
      error: function () {
        self.collectionThumbs[handle] = [];
        callback([]);
      },
    });
  },
  htmlProduct: function (data) {
    var html = '';
    var list = data.products || [];
    var noImage = 'https://file.hstatic.net/200000642007/file/loading-product_166be939a5b54a2aa4d9653d29b9b21d.jpg';

    list.forEach(function (product) {
      var img = noImage;
      if (product.featured_image) {
        img = Haravan.resizeImage(product.featured_image, 'large');
      } else if (product.images && product.images.length) {
        var first = typeof product.images[0] === 'string' ? product.images[0] : product.images[0].src;
        if (first) {
          img = Haravan.resizeImage(first, 'large');
        }
      }

      var price = 0;
      var compare_at_price = 0;
      if (product.variants && product.variants.length) {
        price = Number(product.variants[0].price);
        compare_at_price = Number(product.variants[0].compare_at_price);
      } else if (product.price) {
        price = Number(product.price);
        compare_at_price = Number(product.compare_at_price);
      }

      html += '<div class="item-product">';
      html += '<a class="item-product__link" href="' + product.url + '" title="' + product.title + '">';
      html += '<div class="item-product__image"><img src="' + img + '" alt="' + product.title + '" loading="lazy"></div>';
      html += '<div class="item-product__info">';
      html += '<h4 class="item-product__title">' + product.title + '</h4>';
      html += '<span class="item-product__price">' + Haravan.formatMoney(price * 100, shop.moneyFormat) + '</span>';
      if (compare_at_price) {
        html += '<span class="item-product__compare-price">' + Haravan.formatMoney(compare_at_price * 100, shop.moneyFormat) + '</span>';
      }
      html += '</div></a></div>';
    });

    return html;
  },
  htmlCollectionItem: function (item, thumbs) {
    var labels = this.labels();
    var count = item.products_count || 0;
    var thumbsHtml = '';
    var images = thumbs && thumbs.length ? thumbs.slice(0, 4) : [];

    if (!images.length && item.image) {
      images = [Haravan.resizeImage(item.image, 'small')];
    }

    if (images.length) {
      images.forEach(function (src) {
        thumbsHtml += '<span class="item-collection__thumb"><img src="' + src + '" alt="' + item.title + '"></span>';
      });
    } else {
      thumbsHtml = '<span class="item-collection__thumb item-collection__thumb--empty"></span>';
    }

    var html = '';
    html += '<div class="swiper-slide">';
    html += '<a class="item-collection" href="/collections/' + item.handle + '" title="' + item.title + '">';
    html += '<div class="item-collection__thumbs">' + thumbsHtml + '</div>';
    html += '<div class="item-collection__info">';
    html += '<h4 class="item-collection__title">' + item.title + '</h4>';
    html += '<span class="item-collection__count">' + count + ' ' + labels.productsCount + '</span>';
    html += '</div></a></div>';
    return html;
  },
  htmlBlog: function (articles) {
    var html = '';
    (articles || []).forEach(function (article) {
      var excerpt = '';
      if (article.summary_html) {
        excerpt = $('<div>').html(article.summary_html).text();
      } else if (article.content) {
        excerpt = $('<div>').html(article.content).text();
      } else if (article.body_html) {
        excerpt = $('<div>').html(article.body_html).text();
      }
      if (excerpt.length > 90) {
        excerpt = excerpt.substring(0, 90) + '...';
      }

      var url = article.url || '';
      if (!url && article.handle) {
        url = '/blogs/news/' + article.handle;
      }

      html += '<div class="swiper-slide">';
      html += '<a class="item-blog" href="' + url + '" title="' + article.title + '">';
      html += '<h4 class="item-blog__title">' + article.title + '</h4>';
      html += '<p class="item-blog__excerpt">' + excerpt + '</p>';
      html += '</a></div>';
    });
    return html;
  },
  renderCollections: function (collections, callback) {
    var self = this;
    var $wrap = $('#mini-search .wrap-collections');
    var $section = $('#mini-search .mini-search__section--collections');

    if (!collections.length) {
      $wrap.empty();
      $section.addClass('is-hidden');
      self.destroySwiper('collections');
      if (typeof callback === 'function') {
        callback();
      }
      return;
    }

    $section.removeClass('is-hidden');
    var pending = collections.length;
    var htmlMap = new Array(collections.length);

    collections.forEach(function (item, index) {
      self.getCollectionThumbs(item.handle, function (thumbs) {
        htmlMap[index] = self.htmlCollectionItem(item, thumbs);
        pending -= 1;
        if (pending <= 0) {
          $wrap.html(htmlMap.join(''));
          self.initSwiper('collections');
          if (typeof callback === 'function') {
            callback();
          }
        }
      });
    });
  },
  initSwiper: function (type) {
    var self = this;
    self.destroySwiper(type);

    if (typeof Swiper === 'undefined') {
      return;
    }

    var selector = type === 'blogs'
      ? '.mini-search__swiper--blogs'
      : '.mini-search__swiper--collections';
    var navSelector = type === 'blogs'
      ? '.mini-search__nav--blogs'
      : '.mini-search__nav--collections';
    var $el = $(selector);
    var slideCount = $el.find('.swiper-slide').length;

    if (!slideCount) {
      return;
    }

    var $nav = $(navSelector);
    if (slideCount <= 3) {
      $nav.addClass('is-hidden');
    } else {
      $nav.removeClass('is-hidden');
    }

    self.swipers[type] = new Swiper(selector, {
      slidesPerView: 1.2,
      spaceBetween: 12,
      speed: 400,
      watchOverflow: true,
      navigation: {
        nextEl: navSelector + ' .mini-search__nav-btn--next',
        prevEl: navSelector + ' .mini-search__nav-btn--prev',
      },
      breakpoints: {
        576: {
          slidesPerView: 2.2,
          spaceBetween: 14,
        },
        768: {
          slidesPerView: 3,
          spaceBetween: 16,
        },
        992: {
          slidesPerView: 3.2,
          spaceBetween: 16,
        },
      },
    });
  },
  destroySwiper: function (type) {
    if (this.swipers[type] && typeof this.swipers[type].destroy === 'function') {
      this.swipers[type].destroy(true, true);
      this.swipers[type] = null;
    }
  },
  destroySwipers: function () {
    this.destroySwiper('collections');
    this.destroySwiper('blogs');
  },
  query: function (key) {
    var self = this;
    var labels = self.labels();
    var keyLower = key.toLowerCase();
    var pending = 3;

    function doneOne() {
      pending -= 1;
      if (pending <= 0) {
        if (self.currentKeyword !== key) {
          return;
        }

        var hasAny =
          !$('#mini-search .mini-search__section--products').hasClass('is-hidden') ||
          !$('#mini-search .mini-search__section--collections').hasClass('is-hidden') ||
          !$('#mini-search .mini-search__section--blogs').hasClass('is-hidden');

        if (!hasAny) {
          $('#mini-search .wrap-product').html(
            '<div class="mini-search__empty">' + labels.noResult + '</div>'
          );
          $('#mini-search .mini-search__section--products').removeClass('is-hidden');
        }

        $('#mini-search .mini-search__view-all')
          .attr('href', '/search?q=' + encodeURIComponent(key))
          .text(labels.viewAll);
        $('#mini-search .mini-search__footer').removeClass('is-hidden');
        self.removeLoading();
      }
    }

    $('#mini-search .mini-search__collections-title').text(labels.collections);

    $('#mini-search .mini-search__section-title').first().text(labels.products);

    var productQuery =
      '(((title:product=' +
      key +
      '))||((title:product**' +
      key +
      '))||((barcode:product**' +
      key +
      '))||((variant:product**' +
      key +
      '))||((sku:product**' +
      key +
      '))||((tag:product**' +
      key +
      ')))&&((price:product>0))&&((available:product=true))';

    self.searchRequest(
      {
        q: 'filter=' + productQuery,
        type: 'product',
        page: 1,
        limit: 8,
      },
      function (response) {
        if (self.currentKeyword !== key) {
          doneOne();
          return;
        }
        if (response && response.total > 0 && response.products && response.products.length) {
          $('#mini-search .wrap-product').html(self.htmlProduct(response));
          $('#mini-search .mini-search__section--products').removeClass('is-hidden');
        } else {
          $('#mini-search .wrap-product').empty();
          $('#mini-search .mini-search__section--products').addClass('is-hidden');
        }
        doneOne();
      }
    );

    self.ensureCollections(function () {
      if (self.currentKeyword !== key) {
        doneOne();
        return;
      }
      var filtered = self.allCollections
        .filter(function (item) {
          return item.title && item.title.toLowerCase().indexOf(keyLower) !== -1;
        })
        .slice(0, 12);
      self.renderCollections(filtered, function () {
        doneOne();
      });
    });

    var articleQuery =
      '((title:product**' + key + ')||(tag:product**' + key + '))';

    self.searchRequest(
      {
        q: 'filter=' + articleQuery,
        type: 'article',
        page: 1,
        limit: 8,
      },
      function (response) {
        if (self.currentKeyword !== key) {
          doneOne();
          return;
        }
        var articles = [];
        if (response) {
          if (response.articles && response.articles.length) {
            articles = response.articles;
          } else if (response.results && response.results.length) {
            articles = response.results;
          } else if (response.products && response.products.length) {
            articles = response.products;
          }
        }

        if (articles.length) {
          $('#mini-search .wrap-blogs').html(self.htmlBlog(articles));
          $('#mini-search .mini-search__section--blogs').removeClass('is-hidden');
          self.initSwiper('blogs');
        } else {
          $('#mini-search .wrap-blogs').empty();
          $('#mini-search .mini-search__section--blogs').addClass('is-hidden');
          self.destroySwiper('blogs');
        }
        doneOne();
      }
    );
  },
}
MLPRO.FormCustomerMSO = {
