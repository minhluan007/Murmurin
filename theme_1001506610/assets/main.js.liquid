  switchSort: function (sort) {
    var isSortt = '';
    switch (sort) {
      case 'price-ascending':
        isSortt = '(price:product=asc)';
        break;
      case 'price-descending':
        isSortt = '(price:product=desc)';
        break;
      case 'title-ascending':
        isSortt = '(title:product=asc)';
        break;
      case 'title-descending':
        isSortt = '(title:product=desc)';
        break;
      case 'created-ascending':
        isSortt = '(created_at:product=asc)';
        break;
      case 'created-descending':
        isSortt = '(created_at:product=desc)';
        break;
      case 'best-selling':
        isSortt = '(sold_quantity:product=desc)';
        break;
      case 'quantity-descending':
        isSortt = '(quantity:product=desc)';
        break;
    }
    return isSortt;
  },
  productLoopSwiper: function(){
    $('.product-loop__swiper').each(function(){
      var $swiperEl = $(this);
      var slideCount = $swiperEl.find('.swiper-slide').length;
      if(slideCount < 2){
        $swiperEl.find('.product-loop__nav').hide();
        return;
      }
      var swiper = new Swiper(this, {
        slidesPerView: 1,
        allowTouchMove: true,
        speed: 400,
        loop: true,
        navigation: {
          nextEl: $swiperEl.find('.product-loop__nav--next')[0],
          prevEl: $swiperEl.find('.product-loop__nav--prev')[0]
        }
      });
      $swiperEl.find('.product-loop__nav').on('click', function(e){
        e.preventDefault();
        e.stopPropagation();
      });
    });
  },
};
