      speed: 800,
      effect: 'slide'
    });
  },
  swiperMainSlider: function(){
    new Swiper('.banner-swiper', {
      loop: true,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
      },
      speed: 1000
    });
  }
}
GIGI.Init = function(){
  GIGI.Global.init();
  if(shop.template.indexOf('index') != -1){
