      var isValid = true;

      that.clearAllErrors();

      if (!email) {
        that.showFieldError($form, 'email', that.messages.required);
        isValid = false;
      } else if (!that.isValidEmail(email)) {
        that.showFieldError($form, 'email', that.messages.emailInvalid);
        isValid = false;
      }

      if (!password) {
        that.showFieldError($form, 'password', that.messages.required);
        isValid = false;
      }

      if (!isValid) return;

      that.setButtonProcessing($form);

      that.viewAPI('login', function (verifyToken) {
