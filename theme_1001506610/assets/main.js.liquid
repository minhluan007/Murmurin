};
MLPRO.MiniCart = {
  isOpen: false,
  closeTimer: null,
  bound: false,
  init: function () {
    var self = this;
    if (!$('#mini-cart').length) {
      return;
    }
    self.bindEvents();
    self.refresh();
  },
  labels: function () {
    var $el = $('#mini-cart');
    return {
      remove: $el.data('label-remove') || 'Remove',
      decrease: $el.data('label-decrease') || 'Decrease quantity',
      increase: $el.data('label-increase') || 'Increase quantity',
      applySuccess: $el.data('label-apply-success') || 'Discount code applied',
      applyError: $el.data('label-apply-error') || 'Please enter a discount code',
      applyExists: $el.data('label-apply-exists') || 'This discount code is already applied',
      applyInvalid: $el.data('label-apply-invalid') || 'Invalid discount code',
      applyFail: $el.data('label-apply-fail') || 'Could not apply discount code',
      removeCode: $el.data('label-remove-code') || 'Remove discount code',
    };
  },
  bindEvents: function () {
    var self = this;
    var $cart = $('#mini-cart');

    if (self.bound) {
      return;
    }
    self.bound = true;

    $(document).on('click', '.js-open-mini-cart', function (e) {
      e.preventDefault();
      self.refresh(function () {
        self.open();
      });
    });

    $cart.on('click', '[data-mini-cart-close]', function () {
      self.close();
    });

    $cart.on('click', '.js-mini-cart-continue', function () {
      self.close();
    });

    $cart.on('click', '.js-open-modal-mso-new-signup', function () {
      self.close();
    });

    $cart.on('click', '.js-mini-cart-discount-toggle', function () {
      var $discount = $(this).closest('.mini-cart__discount');
      var isOpen = $discount.toggleClass('is-open').hasClass('is-open');
      $(this).attr('aria-expanded', isOpen);
      if (isOpen) {
        $discount.find('.js-mini-cart-discount-input').focus();
      }
    });

    $cart.on('click', '.js-mini-cart-discount-apply', function () {
      self.applyDiscount();
    });

    $cart.on('keydown', '.js-mini-cart-discount-input', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        self.applyDiscount();
      }
    });

    $cart.on('click', '.js-mini-cart-qty', function () {
      var $btn = $(this);
      var variantId = $btn.data('variant-id');
      var qty = parseInt($btn.data('qty'), 10);
      if (!variantId || isNaN(qty)) {
        return;
      }
      self.changeQuantity(variantId, qty);
    });

    $cart.on('click', '.js-mini-cart-remove', function () {
      var variantId = $(this).data('variant-id');
      if (!variantId) {
        return;
      }
      self.changeQuantity(variantId, 0);
    });

    $cart.on('click', '.js-mini-cart-code-remove', function () {
      var code = $(this).data('code');
      if (!code) {
        return;
      }
      self.removeDiscount(code);
    });

    $(document).on('keydown.miniCart', function (e) {
      if (e.key === 'Escape' && self.isOpen) {
        self.close();
      }
    });

    $cart.find('.mini-cart__drawer').on('transitionend', function (e) {
      if (e.target !== this || e.originalEvent.propertyName !== 'transform') {
        return;
      }
      clearTimeout(self.closeTimer);
      self.finishClose();
    });
  },
  open: function () {
    var self = this;
    var $cart = $('#mini-cart');
    if (!$cart.length || self.isOpen) {
      return;
    }
    clearTimeout(self.closeTimer);
    $cart.addClass('is-visible').attr('aria-hidden', 'false');
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        $cart.addClass('is-open');
        self.isOpen = true;
        $('body').addClass('open-mini-cart');
      });
    });
  },
  close: function () {
    var self = this;
    var $cart = $('#mini-cart');
    if (!$cart.hasClass('is-open')) {
      return;
    }
    $cart.removeClass('is-open');
    self.isOpen = false;
    $('body').removeClass('open-mini-cart');
    clearTimeout(self.closeTimer);
    self.closeTimer = setTimeout(function () {
      self.finishClose();
    }, 420);
  },
  finishClose: function () {
    var $cart = $('#mini-cart');
    if (!$cart.hasClass('is-open')) {
      $cart.removeClass('is-visible').attr('aria-hidden', 'true');
    }
  },
  getCheckoutData: function (payload) {
    if (!payload) {
      return {};
    }
    if (payload.checkouts) {
      return payload.checkouts;
    }
    return payload;
  },
  refresh: function (callback) {
    var self = this;
    $.getJSON('/checkouts.js')
      .done(function (result) {
        window.checkoutsJS = result;
        self.render(result);
        if (typeof callback === 'function') {
          callback(result);
        }
      })
      .fail(function () {
        self.render(window.checkoutsJS || {});
        if (typeof callback === 'function') {
          callback(window.checkoutsJS || {});
        }
      });
  },
  formatMoney: function (price) {
    if (typeof Haravan !== 'undefined' && typeof Haravan.formatMoney === 'function') {
      return Haravan.formatMoney(price * 100, shop.moneyFormat);
    }
    return price;
  },
  escapeHtml: function (text) {
    return $('<div>').text(text == null ? '' : text).html();
  },
  getItems: function (checkout) {
    return checkout.line_items || checkout.items || [];
  },
  getItemCount: function (checkout, items) {
    if (checkout.item_count != null) {
      return parseInt(checkout.item_count, 10) || 0;
    }
    return items.reduce(function (sum, item) {
      return sum + (parseInt(item.quantity, 10) || 0);
    }, 0);
  },
  getTotalPrice: function (checkout) {
    if (checkout.total_price != null) {
      return checkout.total_price;
    }
    if (checkout.payment_due != null) {
      return checkout.payment_due;
    }
    if (checkout.subtotal_price != null) {
      return checkout.subtotal_price;
    }
    return 0;
  },
  getAppliedCoupons: function (checkout) {
    var list = [];
    var allocations = checkout.discount_allocations || [];

    allocations.forEach(function (item) {
      if (item && item.code && item.code !== 'LOYALTY_POINT') {
        list.push(item.code);
      }
    });

    if (checkout.gift_cards && checkout.gift_cards.length) {
      checkout.gift_cards.forEach(function (gift) {
        if (gift && gift.name) {
          list.push(gift.name);
        }
      });
    }

    return list;
  },
  getDiscountDetails: function (checkout) {
    var details = [];
    var allocations = checkout.discount_allocations || [];

    allocations.forEach(function (item) {
      if (!item || !item.code || item.code === 'LOYALTY_POINT') {
        return;
      }
      details.push({
        code: item.code,
        amount: Math.abs(item.savings != null ? item.savings : (item.amount != null ? item.amount : 0)),
      });
    });

    if (checkout.gift_cards && checkout.gift_cards.length) {
      checkout.gift_cards.forEach(function (gift) {
        if (!gift || !gift.name) {
          return;
        }
        details.push({
          code: gift.name,
          amount: Math.abs(gift.amount_used != null ? gift.amount_used : (gift.balance != null ? gift.balance : 0)),
        });
      });
    }

    return details;
  },
  getItemImage: function (item) {
    var image = item.image || item.image_url || '';
    if (!image && item.inAdmin && item.inAdmin.featured_image) {
      image = item.inAdmin.featured_image;
    }
    if (!image) {
      return '';
    }
    if (typeof Haravan !== 'undefined' && typeof Haravan.resizeImage === 'function' && image.indexOf('http') === 0) {
      return Haravan.resizeImage(image, 'small');
    }
    return image;
  },
  getItemUrl: function (item) {
    if (item.url) {
      return item.url;
    }
    if (item.handle) {
      return '/products/' + item.handle;
    }
    if (item.product_id) {
      return '/products/' + item.product_id;
    }
    return '#';
  },
  renderItem: function (item) {
    var self = this;
    var labels = self.labels();
    var image = self.getItemImage(item);
    var title = item.product_title || item.title || '';
    var variant = item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '';
    var unitPrice = self.formatMoney(item.price);
    var linePrice = self.formatMoney(item.line_price != null ? item.line_price : item.price * item.quantity);
    var qty = parseInt(item.quantity, 10) || 1;
    var url = self.getItemUrl(item);
    var variantId = item.variant_id || item.id;

    var imageHtml = image
      ? '<img src="' + image + '" alt="' + self.escapeHtml(title) + '" loading="lazy">'
      : '<span class="mini-cart__item-placeholder">No image</span>';

    return (
      '<div class="mini-cart__item" data-variant-id="' + variantId + '">' +
        '<div class="mini-cart__item-image">' +
          '<a href="' + url + '">' + imageHtml + '</a>' +
        '</div>' +
        '<div class="mini-cart__item-info">' +
          '<div class="mini-cart__item-top">' +
            '<h3 class="mini-cart__item-title"><a href="' + url + '">' + self.escapeHtml(title) + '</a></h3>' +
            '<span class="mini-cart__item-line-price">' + linePrice + '</span>' +
          '</div>' +
          (variant ? '<p class="mini-cart__item-variant">' + self.escapeHtml(variant) + '</p>' : '') +
          '<p class="mini-cart__item-price">' + unitPrice + '</p>' +
          '<div class="mini-cart__item-actions">' +
            '<div class="mini-cart__qty">' +
              '<button type="button" class="mini-cart__qty-btn js-mini-cart-qty" data-variant-id="' + variantId + '" data-qty="' + (qty - 1) + '" aria-label="' + labels.decrease + '">−</button>' +
              '<span class="mini-cart__qty-value">' + qty + '</span>' +
              '<button type="button" class="mini-cart__qty-btn js-mini-cart-qty" data-variant-id="' + variantId + '" data-qty="' + (qty + 1) + '" aria-label="' + labels.increase + '">+</button>' +
            '</div>' +
            '<button type="button" class="mini-cart__remove js-mini-cart-remove" data-variant-id="' + variantId + '" aria-label="' + labels.remove + '">' +
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
                '<path d="M4 7H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
                '<path d="M9 7V5C9 4.448 9.448 4 10 4H14C14.552 4 15 4.448 15 5V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
                '<path d="M18 7L17.2 19.1C17.13 20.16 16.26 21 15.2 21H8.8C7.74 21 6.87 20.16 6.8 19.1L6 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
                '<path d="M10 11V17M14 11V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
              '</svg>' +
            '</button>' +
          '</div>' +
        '</div>' +
      '</div>'
    );
  },
  renderAppliedDiscounts: function (checkout) {
    var self = this;
    var labels = self.labels();
    var details = self.getDiscountDetails(checkout);

    if (!details.length) {
      return '';
    }

    return details.map(function (item) {
      var amountText = item.amount
        ? '-' + self.formatMoney(item.amount)
        : '';
      return (
        '<div class="mini-cart__applied-item" data-code="' + self.escapeHtml(item.code) + '">' +
          '<span class="mini-cart__applied-code">' + self.escapeHtml(item.code) + '</span>' +
          '<div class="mini-cart__applied-right">' +
            (amountText ? '<span class="mini-cart__applied-amount">' + amountText + '</span>' : '') +
            '<button type="button" class="mini-cart__applied-remove js-mini-cart-code-remove" data-code="' + self.escapeHtml(item.code) + '" aria-label="' + labels.removeCode + '">' +
              '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
                '<path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>' +
              '</svg>' +
            '</button>' +
          '</div>' +
        '</div>'
      );
    }).join('');
  },
  render: function (payload) {
    var self = this;
    var $cart = $('#mini-cart');
    if (!$cart.length) {
      return;
    }

    var checkout = self.getCheckoutData(payload);
    var items = self.getItems(checkout);
    var itemCount = self.getItemCount(checkout, items);
    var isEmpty = itemCount <= 0 || !items.length;
    var totalPrice = self.getTotalPrice(checkout);

    $cart.find('.mini-cart__state--empty').toggleClass('is-active', isEmpty);
    $cart.find('.mini-cart__state--filled').toggleClass('is-active', !isEmpty);
    $cart.find('.js-mini-cart-count').text(itemCount);
    $cart.find('.js-mini-cart-total').text(self.formatMoney(totalPrice));
    $cart.find('.js-mini-cart-applied').html(isEmpty ? '' : self.renderAppliedDiscounts(checkout));

    if (isEmpty) {
      $cart.find('.js-mini-cart-items').empty();
    } else {
      var html = items.map(function (item) {
        return self.renderItem(item);
      }).join('');
      $cart.find('.js-mini-cart-items').html(html);
    }

    self.updateHeaderCount(itemCount);
  },
  updateHeaderCount: function (count) {
    var $badge = $('.site-header__cart-count');
    if (!$badge.length) {
      return;
    }
    count = parseInt(count, 10) || 0;
    $badge.text(count);
    if (count > 0) {
      $badge.show();
    } else {
      $badge.hide();
    }
  },
  setLoading: function (isLoading) {
    $('#mini-cart').toggleClass('is-loading', !!isLoading);
  },
  showDiscountMessage: function (type, text) {
    var $message = $('#mini-cart .js-mini-cart-discount-message');
    $message
      .removeAttr('hidden')
      .removeClass('is-success is-error')
      .addClass(type === 'success' ? 'is-success' : 'is-error')
      .text(text || '');
  },
  clearDiscountMessage: function () {
    $('#mini-cart .js-mini-cart-discount-message')
      .attr('hidden', true)
      .removeClass('is-success is-error')
      .text('');
  },
  postDiscounts: function (coupons, callback) {
    var self = this;
    $.ajax({
      url: '/checkouts/discounts.js',
      type: 'POST',
      contentType: 'application/json',
      dataType: 'json',
      data: JSON.stringify({ coupons: coupons }),
      success: function (result) {
        window.checkoutsJS = result;
        self.render(result);
        if (typeof callback === 'function') {
          callback(null, result);
        }
      },
      error: function (xhr) {
        if (typeof callback === 'function') {
          callback(xhr || true);
        }
      }
    });
  },
  changeQuantity: function (variantId, quantity) {
    var self = this;
    self.setLoading(true);
    $.ajax({
      type: 'POST',
      url: '/cart/change.js',
      dataType: 'json',
      data: {
        id: variantId,
        quantity: quantity
      },
      success: function () {
        self.refresh(function () {
          self.setLoading(false);
        });
      },
      error: function (xhr, status) {
        self.setLoading(false);
        if (typeof Haravan !== 'undefined' && typeof Haravan.onError === 'function') {
          Haravan.onError(xhr, status);
        }
      }
    });
  },
  applyDiscount: function () {
    var self = this;
    var labels = self.labels();
    var $cart = $('#mini-cart');
    var $input = $cart.find('.js-mini-cart-discount-input');
    var code = $.trim($input.val() || '');
    var checkout = self.getCheckoutData(window.checkoutsJS);
    var uniqueCoupons = self.getAppliedCoupons(checkout);

    self.clearDiscountMessage();

    if (!code) {
      self.showDiscountMessage('error', labels.applyError);
      return;
    }

    if (uniqueCoupons.some(function (item) {
      return String(item).toLowerCase() === code.toLowerCase();
    })) {
      self.showDiscountMessage('error', labels.applyExists);
      return;
    }

    uniqueCoupons.push(code);
    self.setLoading(true);

    self.postDiscounts(uniqueCoupons, function (err, result) {
      self.setLoading(false);

      if (err) {
        self.showDiscountMessage('error', labels.applyFail);
        return;
      }

      var updated = self.getCheckoutData(result);
      var applied = self.getAppliedCoupons(updated);
      var isApplied = applied.some(function (item) {
        return String(item).toLowerCase() === code.toLowerCase();
      });

      $input.val('');

      if (isApplied) {
        self.showDiscountMessage('success', labels.applySuccess);
      } else {
        self.showDiscountMessage('error', labels.applyInvalid);
      }
    });
  },
  removeDiscount: function (codeRemove) {
    var self = this;
    var labels = self.labels();
    var checkout = self.getCheckoutData(window.checkoutsJS);
    var coupons = self.getAppliedCoupons(checkout).filter(function (code) {
      return code !== codeRemove;
    });

    self.clearDiscountMessage();
    self.setLoading(true);

    self.postDiscounts(coupons, function (err) {
      self.setLoading(false);
      if (err) {
        self.showDiscountMessage('error', labels.applyFail);
      }
    });
  }
}
MLPRO.Collection = {
  init: function () {
    this.filter.init();
  },
  filter: {
    isFilter: false,
    limit: 20,
    brand: [],
    type: [],
    priceMin: null,
    priceMax: null,
    priceBoundMin: 0,
    priceBoundMax: 1000000,
    filterPriced: false,
    currentPage: 1,
    sort: '',
    q: '',
    dataColl: typeof varibleCollection !== 'undefined' ? varibleCollection : {},
    priceTimer: null,

    init: function () {
      var self = this;
      if (self.dataColl && self.dataColl.limit) {
        self.limit = parseInt(self.dataColl.limit, 10) || self.limit;
      }
      self.initPriceBounds();
      self.sliderRange();
      self.bindDropdowns();
      self.bindActions();
      if (!self.isMobileFilter()) {
        $('.collection-sidebar').attr('aria-hidden', 'false');
      }
      self.checkUrl();
    },

    parseArgs: function () {
      if (typeof Arg !== 'undefined' && Arg.parse) {
        return Arg.parse(window.location.href) || {};
      }
      var params = {};
      var search = window.location.search.replace(/^\?/, '');
      if (!search) return params;
      search.split('&').forEach(function (pair) {
        if (!pair) return;
        var parts = pair.split('=');
        var key = decodeURIComponent(parts[0] || '');
        var val = decodeURIComponent((parts[1] || '').replace(/\+/g, ' '));
        if (key) params[key] = val;
      });
      return params;
    },

    buildUrl: function (params) {
      if (typeof Arg !== 'undefined' && Arg.url) {
        return Arg.url(params);
      }
      var base = window.location.origin + window.location.pathname;
      var qs = Object.keys(params)
        .filter(function (key) {
          return params[key] !== '' && params[key] != null;
        })
        .map(function (key) {
          return encodeURIComponent(key) + '=' + encodeURIComponent(params[key]);
        })
        .join('&');
      return qs ? base + '?' + qs : base;
    },

    initPriceBounds: function () {
      var self = this;
      var $slider = $('#slider-range');
      var $page = $('.collection-page');
      var fromSliderMin = parseInt($slider.attr('data-min'), 10);
      var fromSliderMax = parseInt($slider.attr('data-max'), 10);
      var fromDataMin = parseInt($page.attr('data-price-min'), 10);
      var fromDataMax = parseInt($page.attr('data-price-max'), 10);
      var fromSettingMin = typeof filterPrice !== 'undefined' ? parseInt(filterPrice.min, 10) : NaN;
      var fromSettingMax = typeof filterPrice !== 'undefined' ? parseInt(filterPrice.max, 10) : NaN;

      self.priceBoundMin = !isNaN(fromSliderMin)
        ? fromSliderMin
        : !isNaN(fromDataMin)
          ? fromDataMin
          : !isNaN(fromSettingMin)
            ? fromSettingMin
            : 0;
      self.priceBoundMax = !isNaN(fromSliderMax) && fromSliderMax > 0
        ? fromSliderMax
        : !isNaN(fromDataMax) && fromDataMax > 0
          ? fromDataMax
          : !isNaN(fromSettingMax) && fromSettingMax > 0
            ? fromSettingMax
            : 1000000;

      if (self.priceBoundMax <= self.priceBoundMin) {
        self.priceBoundMax = self.priceBoundMin + 1000;
      }

      self.priceMin = self.priceBoundMin;
      self.priceMax = self.priceBoundMax;

      if (typeof filterPrice !== 'undefined') {
        filterPrice.min = self.priceBoundMin;
        filterPrice.max = self.priceBoundMax;
      }
    },

    sliderRange: function () {
      var self = this;
      var $slider = $('#slider-range');
      if (!$slider.length || typeof $.fn.slider !== 'function') {
        console.warn('jQuery UI slider is not available');
        return;
      }

      $slider.slider({
        range: true,
        min: self.priceBoundMin,
        max: self.priceBoundMax,
        values: [self.priceBoundMin, self.priceBoundMax],
        step: 1000,
        slide: function (event, ui) {
          self.updatePriceDisplay(ui.values[0], ui.values[1]);
        },
        stop: function (event, ui) {
          self.updatePriceDisplay(ui.values[0], ui.values[1]);
          if (!self.filterPriced) {
            self.filterPriced = true;
          }
          clearTimeout(self.priceTimer);
          self.priceTimer = setTimeout(function () {
            self.buildParam(true);
          }, 150);
        },
      });

      var firstPrice = $slider.slider('values', 0);
      var firstPrice2 = $slider.slider('values', 1);
      self.updatePriceDisplay(firstPrice, firstPrice2);
    },

    updatePriceDisplay: function (minVal, maxVal) {
      var self = this;
      minVal = parseInt(minVal, 10);
      maxVal = parseInt(maxVal, 10);
      if (isNaN(minVal)) minVal = self.priceBoundMin;
      if (isNaN(maxVal)) maxVal = self.priceBoundMax;

      self.priceMin = minVal;
      self.priceMax = maxVal;

      var minPrice = Haravan.formatMoney(minVal * 100, shop.moneyFormat);
      var maxPrice = Haravan.formatMoney(maxVal * 100, shop.moneyFormat);

      $('#priceMin').val(minPrice);
      $('#priceMax').val(maxPrice);
      $('.text-show-price-l').html(minPrice).attr('data-price', minVal);
      $('.text-show-price-r').html(maxPrice).attr('data-price', maxVal);
      $('input[name="price"]').val(minVal + '_' + maxVal);
    },

    setPriceUI: function (minVal, maxVal, resetFlag) {
      var self = this;
      minVal = parseInt(minVal, 10);
      maxVal = parseInt(maxVal, 10);
      if (isNaN(minVal)) minVal = self.priceBoundMin;
      if (isNaN(maxVal)) maxVal = self.priceBoundMax;
      minVal = Math.max(self.priceBoundMin, Math.min(minVal, self.priceBoundMax));
      maxVal = Math.max(self.priceBoundMin, Math.min(maxVal, self.priceBoundMax));
      if (minVal > maxVal) minVal = maxVal;

      var $slider = $('#slider-range');
      if ($slider.length && typeof $.fn.slider === 'function' && $slider.hasClass('ui-slider')) {
        $slider.slider('values', [minVal, maxVal]);
      }

      self.updatePriceDisplay(minVal, maxVal);

      if (resetFlag) {
        self.filterPriced = false;
      } else if (minVal > self.priceBoundMin || maxVal < self.priceBoundMax) {
        self.filterPriced = true;
      }
    },

    isPriceFiltered: function () {
      return this.filterPriced && (this.priceMin > this.priceBoundMin || this.priceMax < this.priceBoundMax);
    },

    isMobileFilter: function () {
      return window.matchMedia('(max-width: 991px)').matches;
    },

    closeDesktopDropdowns: function () {
      $('.collection-filter').removeClass('is-open');
      $('.collection-filter > .collection-filter__trigger').attr('aria-expanded', 'false');
    },

    openSidebar: function () {
      var self = this;
      if (!self.isMobileFilter()) return;

      $('body').addClass('open-collection-filter');
      $('.collection-sidebar').attr('aria-hidden', 'false');
      $('[data-open-collection-filter]').attr('aria-expanded', 'true');

      // Mobile accordion: mở sẵn các nhóm
      $('.collection-filter').addClass('is-open');
      $('.collection-filter > .collection-filter__trigger').attr('aria-expanded', 'true');

      var $slider = $('#slider-range');
      if ($slider.length && typeof $.fn.slider === 'function' && $slider.hasClass('ui-slider')) {
        requestAnimationFrame(function () {
          var values = $slider.slider('values');
          $slider.slider('option', 'values', values);
          self.updatePriceDisplay(values[0], values[1]);
        });
      }
    },

    closeSidebar: function () {
      var self = this;
      var $sidebar = $('.collection-sidebar');
      var $panel = $sidebar.find('.collection-sidebar__panel');

      $('body').removeClass('open-collection-filter');
      $('[data-open-collection-filter]').attr('aria-expanded', 'false');

      var finishClose = function () {
        $sidebar.attr('aria-hidden', 'true');
        if (self.isMobileFilter()) {
          self.closeDesktopDropdowns();
        }
      };

      // Đợi panel slide-out xong rồi mới collapse accordion
      if (self.isMobileFilter() && $panel.length) {
        var done = false;
        var onEnd = function (e) {
          if (done) return;
          if (e && e.target !== $panel[0]) return;
          if (e && e.originalEvent && e.originalEvent.propertyName !== 'transform') return;
          done = true;
          $panel.off('transitionend', onEnd);
          finishClose();
        };
        $panel.on('transitionend', onEnd);
        setTimeout(onEnd, 350);
      } else {
        finishClose();
      }
    },

    syncClearButton: function () {
      var $btn = $('.collection-sidebar__clear');
      if (!$btn.length) return;
      if (this.isFilter) {
        $btn.removeClass('d-none');
      } else {
        $btn.addClass('d-none');
      }
    },

    bindDropdowns: function () {
      var self = this;

      $(document).on('click', '[data-open-collection-filter]', function (e) {
        e.preventDefault();
        self.openSidebar();
      });

      $(document).on('click', '[data-close-collection-filter]', function (e) {
        e.preventDefault();
        self.closeSidebar();
      });

      $(document).on('click', '[data-apply-collection-filter]', function (e) {
        e.preventDefault();
        self.buildParam(true);
        self.closeSidebar();
      });

      $(document).on('keydown', function (e) {
        if (e.key === 'Escape') {
          if ($('body').hasClass('open-collection-filter')) {
            self.closeSidebar();
          } else {
            self.closeDesktopDropdowns();
          }
        }
      });

      $(document).on('click', '.collection-sidebar__body .collection-filter > .collection-filter__trigger', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $filter = $(this).closest('.collection-filter');
        var isOpen = $filter.hasClass('is-open');

        if (self.isMobileFilter()) {
          $filter.toggleClass('is-open', !isOpen);
          $(this).attr('aria-expanded', isOpen ? 'false' : 'true');
          return;
        }

        // Desktop: chỉ mở 1 dropdown
        $('.collection-filter').not($filter).removeClass('is-open');
        $('.collection-filter').not($filter).find('> .collection-filter__trigger').attr('aria-expanded', 'false');
        $filter.toggleClass('is-open', !isOpen);
        $(this).attr('aria-expanded', isOpen ? 'false' : 'true');

        if ($filter.hasClass('collection-filter--price') && $filter.hasClass('is-open')) {
          var $slider = $('#slider-range');
          if ($slider.length && typeof $.fn.slider === 'function' && $slider.hasClass('ui-slider')) {
            requestAnimationFrame(function () {
              var values = $slider.slider('values');
              $slider.slider('option', 'values', values);
              self.updatePriceDisplay(values[0], values[1]);
            });
          }
        }
      });

      $(document).on('click', '.collection-filter__dropdown', function (e) {
        e.stopPropagation();
      });

      $(document).on('click', function () {
        if (!self.isMobileFilter()) {
          self.closeDesktopDropdowns();
        }
      });
    },

    bindActions: function () {
      var self = this;

      $(document).on('change', '.collection-filter input[name="brand"], .collection-filter input[name="type"]', function () {
        self.buildParam(true);
      });

      $(document).on('click', '.sort-by-content li', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $li = $(this);
        $('.sort-by-content').addClass('sorted');
        $('.sort-by-content li').removeClass('active');
        $li.addClass('active');
        var title = $li.find('span').text();
        $('.show-sort').text(title);
        if (!self.isMobileFilter()) {
          self.closeDesktopDropdowns();
        }
        self.buildParam(true);
      });

      $(document).on('click', '.pagi-ajax .prev-pagi:not(.disabled), .pagi-ajax .next-pagi:not(.disabled), .pagi-ajax .pagiItem span:not(.active):not(.disabled):not(.span-non)', function (e) {
        e.preventDefault();
        var page = $(this).attr('data-page');
        if (!page) return;
        var url = self.parseArgs();
        url.page = page;
        window.location = self.buildUrl(url);
      });

      $(document).on('click', '.clear-all, .back-normal, [data-clear-collection-filter]', function (e) {
        e.preventDefault();
        $('input[name="brand"], input[name="type"]').prop('checked', false);
        $('.sort-by-content').removeClass('sorted');
        $('.sort-by-content li').removeClass('active').first().addClass('active');
        $('.show-sort').text('Mặc định');
        self.setPriceUI(self.priceBoundMin, self.priceBoundMax, true);
        self.buildParam(true);
      });
    },

    reFillSort: function (value) {
      var $el = $('.sort-by-content span[data-value="' + value + '"]');
      if (!$el.length) return;
      $('.sort-by-content').addClass('sorted');
      $('.sort-by-content li').removeClass('active');
      $el.parent().addClass('active');
      $('.show-sort').text($el.text());
    },

    checkDefaultSort: function () {
      var value = this.dataColl.defaultSortBy;
      if (!value || value === 'manual') return;
      this.reFillSort(value);
    },

    isSearchTemplate: function () {
      return typeof shop !== 'undefined' && shop.template && shop.template.indexOf('search') !== -1;
    },

    hasExtraFilters: function () {
      return this.brand.length > 0 || this.type.length > 0 || this.isPriceFiltered();
    },

    checkUrl: function () {
      var self = this;
      var params = self.parseArgs();
      var $collection = self.dataColl;
      var isSearch = self.isSearchTemplate();

      self.brand = [];
      self.type = [];
      self.sort = '';
      self.q = '';
      self.currentPage = params.page ? parseInt(params.page, 10) || 1 : 1;
      self.setPriceUI(self.priceBoundMin, self.priceBoundMax, true);
      $('input[name="brand"], input[name="type"]').prop('checked', false);

      if (params.brand) {
        self.brand = params.brand.indexOf(',') > -1 ? params.brand.split(',') : [params.brand];
        self.brand.forEach(function (item) {
          $('input[name="brand"][value="' + item.replace(/"/g, '\\"') + '"]').prop('checked', true);
        });
      }
      if (params.type) {
        self.type = params.type.indexOf(',') > -1 ? params.type.split(',') : [params.type];
        self.type.forEach(function (item) {
          $('input[name="type"][value="' + item.replace(/"/g, '\\"') + '"]').prop('checked', true);
        });
      }
      if (params.price) {
        var parts = String(params.price).split('_');
        var minVal = parseInt(parts[0], 10);
        var maxVal = parseInt(parts[1], 10);
        if (!isNaN(minVal) && !isNaN(maxVal)) {
          self.setPriceUI(minVal, maxVal, false);
        }
      }
      if (params.sort) {
        self.sort = params.sort;
        self.reFillSort(params.sort);
      } else {
        self.checkDefaultSort();
      }

      // q chỉ xử lý trên template search
      if (isSearch && params.q) {
        self.q = $.trim(String(params.q));
      }

      self.isFilter = self.brand.length > 0 || self.type.length > 0 || self.isPriceFiltered() || !!self.sort;
      if (isSearch && self.q) {
        self.isFilter = true;
      }
      self.syncClearButton();

      if (isSearch) {
        if (self.q) {
          self.filterRender();
        } else {
          self.handleSearchNoQuery();
        }
        return;
      }

      if (self.isFilter) {
        self.filterRender();
      } else {
        self.normalRender($collection.handle, self.currentPage);
      }
    },

    handleSearchNoQuery: function () {
      $('.search-page .collection-toolbar').addClass('d-none');
      $('.render-product').html('').addClass('empty-product');
      this.countResultItem(0);
      $('.pagi-ajax').html('').addClass('d-none');
      if (MLPRO.Search && typeof MLPRO.Search.showEmpty === 'function') {
        MLPRO.Search.showEmpty('');
      }
    },

    buildParam: function (resetPage) {
      var self = this;
      var brand = [];
      var type = [];
      var sort = $('.sort-by-content li.active span').attr('data-value') || '';
      var isSearch = self.isSearchTemplate();

      if (!$('.sort-by-content').hasClass('sorted') || sort === 'manual') {
        sort = '';
      }

      $('input[name="brand"]:checked').each(function () {
        brand.push($(this).val());
      });
      $('input[name="type"]:checked').each(function () {
        type.push($(this).val());
      });

      var params = self.parseArgs();
      params.brand = brand.length ? brand.join(',') : '';
      params.type = type.length ? type.join(',') : '';
      params.price = self.isPriceFiltered() ? self.priceMin + '_' + self.priceMax : '';
      params.sort = sort;
      if (resetPage) {
        params.page = '';
        self.currentPage = 1;
      }

      // q chỉ giữ trên URL template search
      if (isSearch) {
        params.q = self.q || params.q || '';
      } else {
        params.q = '';
      }

      window.history.replaceState('', '', self.buildUrl(params));
      self.checkUrl();
    },

    query: function () {
      var self = this;
      var $collection = self.dataColl;
      var cid = parseInt($collection.id, 10) || 0;
      var isSearch = self.isSearchTemplate();
      var q = cid !== 0 ? '((collectionid:product=' + cid + '))' : '((collectionid:product>0))';
      if (isSearch) {
        q = '((collectionid:product>0))';
      }

      if (self.brand.length > 0) {
        var brandQuery = self.brand
          .map(function (item) {
            return '(vendor:product=' + item + ')';
          })
          .join('||');
        q += '&&(' + brandQuery + ')';
      }

      if (self.type.length > 0) {
        var typeQuery = self.type
          .map(function (item) {
            return '(product_type:product=' + item + ')';
          })
          .join('||');
        q += '&&(' + typeQuery + ')';
      }

      if (self.isPriceFiltered()) {
        q += '&&((price_variant:product range ' + self.priceMin + '_' + self.priceMax + '))';
      }

      if (isSearch && self.q) {
        q += '&&((title:product contains ' + self.q + '))';
      }

      q += '&&((tag:product<>gift))&&((available:product=true))';
      return '(' + q + ')';
    },

    countResultItem: function (total) {
      $('.results-count strong').html(total);
    },

    afterRender: function () {
      if (MLPRO.LoopItem && typeof MLPRO.LoopItem.productLoopSwiper === 'function') {
        MLPRO.LoopItem.productLoopSwiper();
      }
    },

    emptyMessage: function () {
      return "<div class='text-center no-product'><p>Không tìm thấy sản phẩm phù hợp</p><div class='clear-all back-normal'><span>Xóa bộ lọc</span></div></div>";
    },

    filterRender: function (isPage) {
      var self = this;
      var query = self.query();
      var sort = $('.sort-by-content li.active span').attr('data-filter') || '';
      var page = isPage != null ? isPage : self.currentPage;
      var limit = self.limit;
      var isSearch = self.isSearchTemplate();

      $.ajax({
        type: 'POST',
        url: '/search.js',
        data: {
          q: 'filter=' + query,
          type: 'product',
          include: 'metafields[product,hrvmultilang_en]',
          page: page,
          limit: limit,
          sortby: sort,
        },
        success: function (response) {
          if (response.total > 0) {
            var items = MLPRO.LoopItem.loopHtml(response, '', '');
            $('.render-product').html(items).removeClass('empty-product');
            self.countResultItem(response.total);
            self.buildPaginate(response.total, limit);
            self.afterRender();
            if (isSearch && MLPRO.Search && typeof MLPRO.Search.hideEmpty === 'function') {
              MLPRO.Search.hideEmpty();
            }
          } else {
            self.countResultItem(0);
            $('.pagi-ajax').html('').addClass('d-none');
            if (isSearch) {
              // Chỉ suggest khi keyword không ra SP; filter phụ → giữ toolbar + thông báo bộ lọc
              if (self.hasExtraFilters()) {
                if (MLPRO.Search && typeof MLPRO.Search.hideEmpty === 'function') {
                  MLPRO.Search.hideEmpty();
                }
                $('.render-product').html(self.emptyMessage()).addClass('empty-product');
              } else {
                $('.render-product').html('').addClass('empty-product');
                if (MLPRO.Search && typeof MLPRO.Search.showEmpty === 'function') {
                  MLPRO.Search.showEmpty(self.q);
                }
              }
            } else {
              $('.render-product').html(self.emptyMessage()).addClass('empty-product');
            }
          }
        },
      });
    },

    normalRender: function (handle, page) {
      var self = this;
      var limit = self.limit;
      var $collection = self.dataColl;
      var sortValue = $('.sort-by-content li.active span').attr('data-value') || '';

      if (sortValue && sortValue !== 'manual') {
        MLPRO.LoopItem.collectionJS3(handle, page, limit, sortValue, function (response) {
          self.handleNormalResponse(response, $collection, limit);
        });
        return;
      }

      MLPRO.LoopItem.collectionJS2(handle, page, limit, function (response) {
        self.handleNormalResponse(response, $collection, limit);
      });
    },

    handleNormalResponse: function (response, $collection, limit) {
      var self = this;
      if (response.products && response.products.length > 0) {
        var items = MLPRO.LoopItem.loopHtml(response, true, '');
        $('.render-product').html(items).removeClass('empty-product');
        var total = parseInt($collection.totalProduct, 10) || response.products.length;
        self.countResultItem(total);
        self.buildPaginate(total, limit);
        self.afterRender();
      } else {
        $('.render-product')
          .html("<div class='text-center no-product'><p>Không có sản phẩm nào</p></div>")
          .addClass('empty-product');
        self.countResultItem(0);
        $('.pagi-ajax').html('').addClass('d-none');
      }
    },

    buildPaginate: function (number, limit) {
      var self = this;
      limit = parseInt(limit, 10);
      var totalPages = Math.ceil(number / limit);
      var currentPage = self.currentPage || 1;
      if (currentPage > totalPages) currentPage = 1;

      if (totalPages > 1) {
        var html = '<div class="pagination-custom-ajax">';
        html += '<span class="titlePagi">Trang ' + currentPage + ' / ' + totalPages + '</span>';
        html += self.pagination(currentPage, totalPages, 'pagi-item', 'disabled');
        html += '</div>';
        $('.pagi-ajax').html(html).removeClass('d-none');
      } else {
        $('.pagi-ajax').html('').addClass('d-none');
      }
    },

    pagination: function (pageNumber, pageTotal, className, disableClassName) {
      var html = '';
      var htmlPrev = '<svg width="9" height="16" viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 0.5L0.5 8L8 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      var htmlNext = '<svg width="9" height="16" viewBox="0 0 9 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 0.5L8.5 8L1 15.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      var windowSize = $(window).width() < 991 ? 1 : 2;

      if (+pageNumber > 1) {
        html += '<div class="' + className + '"><span class="prev-pagi" data-page="' + (+pageNumber - 1) + '">' + htmlPrev + '</span></div>';
      } else {
        html += '<div class="' + className + ' ' + disableClassName + '"><span class="prev-pagi ' + disableClassName + '" data-page="1">' + htmlPrev + '</span></div>';
      }

      if (+pageNumber - windowSize > 1) {
        html += '<div class="' + className + ' pagiItem"><span data-page="1">1</span></div>';
        html += '<div class="' + className + ' ' + disableClassName + '"><span class="span-non">...</span></div>';
      }

      for (var i = +pageNumber - windowSize; i <= +pageNumber + windowSize; i++) {
        if (i < 1 || i > pageTotal) continue;
        if (+pageNumber === i) {
          html += '<div class="' + className + ' pagiItem"><span class="active" data-page="' + i + '">' + i + '</span></div>';
        } else {
          html += '<div class="' + className + ' pagiItem"><span data-page="' + i + '">' + i + '</span></div>';
        }
      }

      if (+pageNumber + windowSize < pageTotal) {
        html += '<div class="' + className + ' ' + disableClassName + '"><span class="span-non">...</span></div>';
        html += '<div class="' + className + ' pagiItem"><span data-page="' + pageTotal + '">' + pageTotal + '</span></div>';
      }

      if (+pageNumber < pageTotal) {
        html += '<div class="' + className + '"><span class="next-pagi" data-page="' + (+pageNumber + 1) + '">' + htmlNext + '</span></div>';
      } else {
        html += '<div class="' + className + ' ' + disableClassName + '"><span class="next-pagi ' + disableClassName + '" data-page="' + pageTotal + '">' + htmlNext + '</span></div>';
      }

      return html;
    },
  },
};
MLPRO.Product = {
  relatedHandle: 'fe-test',
  relatedLimit: 12,
  noImage: 'https://file.hstatic.net/200000642007/file/loading-product_166be939a5b54a2aa4d9653d29b9b21d.jpg',
  selected: {
    option1: null,
    option2: null,
    option3: null,
  },
  init: function () {
    if (typeof dataProduct === 'undefined' || !dataProduct || !dataProduct.id) {
      return;
    }
    this.renderInfo();
    this.renderGallery();
    this.renderOptions();
    this.bindEvents();
    this.renderRelated();
  },
  getOptionName: function (index) {
    var opt = dataProduct.options && dataProduct.options[index];
    if (!opt) {
      return '';
    }
    if (typeof opt === 'string') {
      return opt;
    }
    return opt.name || '';
  },
  getOptionCount: function () {
    return (dataProduct.options && dataProduct.options.length) || 1;
  },
  getOptionValues: function (optionIndex) {
    var key = 'option' + optionIndex;
    var values = [];
    (dataProduct.variants || []).forEach(function (variant) {
      var value = variant[key];
      if (value && values.indexOf(value) === -1) {
        values.push(value);
      }
    });
    return values;
  },
  findVariant: function () {
    var self = this;
    var optionCount = self.getOptionCount();
    return (dataProduct.variants || []).find(function (variant) {
      if (optionCount >= 1 && variant.option1 !== self.selected.option1) {
        return false;
      }
      if (optionCount >= 2 && variant.option2 !== self.selected.option2) {
        return false;
      }
      if (optionCount >= 3 && variant.option3 !== self.selected.option3) {
        return false;
      }
      return true;
    });
  },
  isOptionValueAvailable: function (optionIndex, value) {
    var self = this;
    var key = 'option' + optionIndex;
    return (dataProduct.variants || []).some(function (variant) {
      if (variant[key] !== value || !variant.available) {
        return false;
      }
      if (optionIndex > 1 && variant.option1 !== self.selected.option1) {
        return false;
      }
      if (optionIndex > 2 && variant.option2 !== self.selected.option2) {
        return false;
      }
      return true;
    });
  },
  renderInfo: function () {
    $('.js-product-title').text(dataProduct.title || '');
    $('.js-product-desc').html(dataProduct.description || dataProduct.content || '');
  },
  normalizeImage: function (image) {
    if (!image) {
      return this.noImage;
    }
    if (typeof image === 'string') {
      return image;
    }
    return image.src || this.noImage;
  },
  renderGallery: function () {
    var self = this;
    var images = dataProduct.images || [];
    var title = dataProduct.title || '';
    var html = '';

    if (!images.length) {
      html =
        '<div class="product-detail__gallery-main product-detail__gallery-main--empty">' +
        '<div class="product-detail__no-image">NO IMAGE -' +
        (shop.name || '') +
        '</div>' +
        '</div>';
      $('.js-product-gallery').html(html);
      return;
    }

    var firstImage = self.normalizeImage(images[0]);
    html +=
      '<div class="product-detail__gallery-main">' +
      '<a href="' +
      firstImage +
      '" class="product-detail__gallery-link" data-fancybox="product-gallery" title="' +
      title +
      '" aria-label="' +
      title +
      '">' +
      '<img class="lazyload" data-src="' +
      firstImage +
      '" alt="' +
      title +
      '">' +
      '</a>' +
      '</div>';

    if (images.length > 1) {
      html += '<div class="product-detail__gallery-grid">';
      images.slice(1).forEach(function (image) {
        var src = self.normalizeImage(image);
        html +=
          '<a href="' +
          src +
          '" class="product-detail__gallery-link" data-fancybox="product-gallery" title="' +
          title +
          '" aria-label="' +
          title +
          '">' +
          '<img class="lazyload" data-src="' +
          src +
          '" alt="' +
          title +
          '">' +
          '</a>';
      });
      html += '</div>';
    }

    $('.js-product-gallery').html(html);
  },
  renderOptions: function () {
    var self = this;
    var optionCount = self.getOptionCount();
    var values1 = self.getOptionValues(1);

    if (!values1.length) {
      self.renderData();
      return;
    }

    self.renderOptionButtons(1, values1);

    if (optionCount > 1) {
      self.renderOption2();
    } else {
      self.renderData();
    }
  },
  renderOptionButtons: function (optionIndex, values) {
    var self = this;
    var html = '';
    var isActive = false;
    var selectedValue = null;
    var label = self.getOptionName(optionIndex - 1);
    var $wrap = $('.product-detail__option--' + optionIndex);

    values.forEach(function (value) {
      var active = '';
      var disabled = '';
      var available = self.isOptionValueAvailable(optionIndex, value);

      if (available && !isActive) {
        isActive = true;
        active = 'active';
        selectedValue = value;
      }
      if (!available) {
        disabled = 'disabled';
      }

      html +=
        '<button type="button" class="product-detail__swatch ' +
        active +
        ' ' +
        disabled +
        '" data-option-index="' +
        optionIndex +
        '" data-value="' +
        value +
        '"' +
        (disabled ? ' disabled' : '') +
        '>' +
        value +
        '</button>';
    });

    self.selected['option' + optionIndex] = selectedValue;
    $wrap.removeClass('d-none');
    $wrap.find('.js-option-label-' + optionIndex).text(label);
    $wrap.find('.js-option-' + optionIndex).html(html);
  },
  renderOption2: function () {
    var self = this;
    var values = self.getOptionValues(2).filter(function (value) {
      return (dataProduct.variants || []).some(function (variant) {
        return variant.option1 === self.selected.option1 && variant.option2 === value;
      });
    });

    if (!values.length) {
      $('.product-detail__option--2, .product-detail__option--3').addClass('d-none');
      self.selected.option2 = null;
      self.selected.option3 = null;
      self.renderData();
      return;
    }

    self.renderOptionButtons(2, values);

    if (self.getOptionCount() > 2) {
      self.renderOption3();
    } else {
      $('.product-detail__option--3').addClass('d-none');
      self.selected.option3 = null;
      self.renderData();
    }
  },
  renderOption3: function () {
    var self = this;
    var values = self.getOptionValues(3).filter(function (value) {
      return (dataProduct.variants || []).some(function (variant) {
        return (
          variant.option1 === self.selected.option1 &&
          variant.option2 === self.selected.option2 &&
          variant.option3 === value
        );
      });
    });

    if (!values.length) {
      $('.product-detail__option--3').addClass('d-none');
      self.selected.option3 = null;
      self.renderData();
      return;
    }

    self.renderOptionButtons(3, values);
    self.renderData();
  },
  renderData: function () {
    this.renderVariant();
    this.renderPrice();
    this.renderStatus();
  },
  renderVariant: function () {
    var variant = this.findVariant();
    if (!variant) {
      return;
    }
    $('#product-select').val(variant.id);
  },
  renderPrice: function () {
    var variant = this.findVariant();
    if (!variant) {
      return;
    }

    $('.js-product-price').html(Haravan.formatMoney(variant.price, shop.moneyFormat));

    if (variant.compare_at_price > variant.price) {
      var discount = variant.compare_at_price - variant.price;
      var discountPercent = (discount / variant.compare_at_price) * 100;
      var finalSale = MLPRO.Module.mathLabelSale(discountPercent);
      $('.js-product-price-discount del').html(Haravan.formatMoney(variant.compare_at_price, shop.moneyFormat));
      $('.js-product-price-discount label').html('-' + finalSale + '%');
      $('.js-product-price-discount').removeClass('d-none');
      $('.js-product-price').addClass('highlight');
    } else {
      $('.js-product-price-discount').addClass('d-none');
      $('.js-product-price').removeClass('highlight');
    }
  },
  renderStatus: function () {
    var variant = this.findVariant();
    var $add = $('.js-add-cart');
    var $buy = $('.js-buy-now');

    if (!variant || !variant.available) {
      $add.addClass('disabled').attr('disabled', 'disabled').find('span').text('Hết hàng');
      $buy.addClass('disabled').attr('disabled', 'disabled');
      return;
    }

    $add.removeClass('disabled').removeAttr('disabled').find('span').text('Thêm vào giỏ');
    $buy.removeClass('disabled').removeAttr('disabled');
  },
  getQuantity: function () {
    var qty = parseInt($('.js-qty-input').val(), 10);
    if (isNaN(qty) || qty < 1) {
      qty = 1;
      $('.js-qty-input').val(1);
    }
    return qty;
  },
  addToCart: function (goCheckout) {
    var self = this;
    var variant = self.findVariant();
    if (!variant || !variant.available) {
      return;
    }

    var qty = self.getQuantity();
    MLPRO.Module.openLoading(function () {
      $.ajax({
        type: 'POST',
        url: '/cart/add.js',
        dataType: 'json',
        data: {
          quantity: qty,
          id: variant.id,
        },
        success: function () {
          MLPRO.Module.removeLoading();
          if (goCheckout) {
            window.location.href = '/checkout';
            return;
          }
          MLPRO.Module.getCartSidebar();
        },
        error: function () {
          MLPRO.Module.removeLoading();
          MLPRO.Module.alertShow('Thông báo', 'Không thể thêm sản phẩm vào giỏ hàng.');
        },
      });
    });
  },
  bindEvents: function () {
    var self = this;

    $(document).on('click', '.product-detail .product-detail__swatch:not(.disabled)', function () {
      var $btn = $(this);
      var optionIndex = parseInt($btn.attr('data-option-index'), 10);
      var value = $btn.attr('data-value');
      if (!optionIndex || !value) {
        return;
      }

      $btn.addClass('active').siblings().removeClass('active');
      self.selected['option' + optionIndex] = value;

      if (optionIndex === 1) {
        if (self.getOptionCount() > 1) {
          self.renderOption2();
        } else {
          self.renderData();
        }
      } else if (optionIndex === 2) {
        if (self.getOptionCount() > 2) {
          self.renderOption3();
        } else {
          self.renderData();
        }
      } else {
        self.renderData();
      }
    });

    $(document).on('click', '.product-detail .js-qty-minus', function () {
      var qty = self.getQuantity();
      if (qty > 1) {
        $('.js-qty-input').val(qty - 1);
      }
    });

    $(document).on('click', '.product-detail .js-qty-plus', function () {
      var qty = self.getQuantity();
      $('.js-qty-input').val(qty + 1);
    });

    $(document).on('change', '.product-detail .js-qty-input', function () {
      self.getQuantity();
    });

    $(document).on('click', '.product-detail .js-add-cart:not(.disabled)', function () {
      self.addToCart(false);
    });

    $(document).on('click', '.product-detail .js-buy-now:not(.disabled)', function () {
      self.addToCart(true);
    });
  },
  renderRelated: function () {
    var self = this;
    var $list = $('.js-product-related');
    if (!$list.length) {
      return;
    }

    var query = "((product_type:product=" + dataProduct.type + "))&&((id:product<>" + dataProduct.id + "))";
    var dataPost = {
      q: 'filter=' + query,
      type: 'product',
      include: 'metafields[product,hrvmultilang_en]',
      page: 1,
      limit: self.relatedLimit,
      sortby: 'created-descending',
    }

    MLPRO.LoopItem.searchJS(dataPost, function (response) {
      if(!response || !response.products || !response.products.length) {
        $list.html('');
        return;
      }

      var items = MLPRO.LoopItem.loopHtml(response, false, false);
      $list.html(items);
      if (MLPRO.LoopItem && typeof MLPRO.LoopItem.productLoopSwiper === 'function') {
        MLPRO.LoopItem.productLoopSwiper();
      }
    });
  },
};
MLPRO.Search = {
  suggestLimit: 12,
  init: function () {
    this.boxSearch();
    MLPRO.Collection.init();
  },
  boxSearch: function () {
    var self = this;
    var $form = $('.search-header__form');
    var $input = $('.search-header__input');
    var $clear = $('.search-header__clear');
    if (!$form.length || !$input.length) {
      return;
    }

    var params = typeof Arg !== 'undefined' && Arg.parse
      ? Arg.parse(window.location.href) || {}
      : {};
    if (params.q) {
      $input.val(params.q);
    }
    self.toggleClear();

    $form.on('submit', function (e) {
      e.preventDefault();
      var key = $.trim($input.val());
      if (!key) {
        return;
      }
      window.location.href = '/search?q=' + encodeURIComponent(key);
    });

    $input.on('input', function () {
      self.toggleClear();
    });

    $clear.on('click', function () {
      $input.val('').focus();
      self.toggleClear();
    });
  },
  toggleClear: function () {
    var hasValue = $.trim($('.search-header__input').val()) !== '';
    $('.search-header__clear').prop('hidden', !hasValue);
  },
  showEmpty: function (keyword) {
    var $empty = $('.search-header__empty');
    var $toolbar = $('.search-page .collection-toolbar');
    var $suggest = $('.search-page__suggest');

    $toolbar.addClass('d-none');

    if ($empty.length) {
      var prefix = $empty.data('empty-prefix') || 'No results found for';
      var suffix = $empty.data('empty-suffix') || 'Check the spelling or use a different word or phrase.';
      var q = $.trim(keyword || '');
      if (q) {
        $empty.text(prefix + ' "' + q + '". ' + suffix);
      } else {
        $empty.text(suffix);
      }
      $empty.removeClass('d-none');
    }

    if ($suggest.length) {
      $suggest.removeClass('d-none');
      this.renderSuggest();
    }
  },
  hideEmpty: function () {
    $('.search-header__empty').addClass('d-none').text('');
    $('.search-page .collection-toolbar').removeClass('d-none');
    $('.search-page__suggest').addClass('d-none');
  },
  renderSuggest: function () {
    var self = this;
    var $list = $('.js-product-suggest');
    var $wrap = $('.search-page__suggest');
    if (!$list.length) {
      return;
    }

    var handle = $wrap.data('handle') || 'fe-test';
    MLPRO.LoopItem.collectionJS2(handle, 1, self.suggestLimit, function (response) {
      if (!response || !response.products || !response.products.length) {
        $list.html('');
        $wrap.addClass('d-none');
        return;
      }

      var items = MLPRO.LoopItem.loopHtml(response, true, false);
      $list.html(items);
      if (MLPRO.LoopItem && typeof MLPRO.LoopItem.productLoopSwiper === 'function') {
        MLPRO.LoopItem.productLoopSwiper();
      }
    });
  },
};

MLPRO.Init = function () {
  MLPRO.Global.init();
  if (shop.template.indexOf('index') != -1) {
    MLPRO.Index.init();
  }
  if (shop.template.indexOf('collection') != -1) {
    MLPRO.Collection.init();
  }
  if (shop.template.indexOf('product') != -1) {
    MLPRO.Product.init();
  }
  if (shop.template.indexOf('search') != -1) {
    MLPRO.Search.init();
  }
};

$(document).ready(function () {
  MLPRO.Init();
});
