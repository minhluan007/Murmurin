MLPRO.Module = {
  findTokenVerification: function($form){
    var token = $form.find('input[name="__RequestVerificationToken"]').val();
    return token;
  },
  openLoading: function(callback){
    $('.loading-ovl').addClass('open');
    if(typeof callback === "function"){
      return callback();
    }
  },
  removeLoading: function(callback){
    $('.loading-ovl').removeClass('open');
    if(typeof callback === "function"){
      return callback();
    }
  },
	toastShow: function(mess){
		var $toast =  $('.toast');
		var textWarning = mess;
		$toast.find('.toast-body').text(textWarning);
		new bootstrap.Toast($toast[0]).show();
	},
	alertShow: function(title, content, options){
		var $modal = $('#fancybox-alert-global');
		options = options || {};

		if(!$modal.length){
			return;
		}

		$modal.find('.fancybox-alert__title').text(title || 'Thông báo');
		$modal.find('.fancybox-alert__content').html(content || '');
		$modal.find('.fancybox-alert__btn').text(options.btnText || 'Đóng');

		if(typeof $.fancybox === 'undefined'){
			window.alert((title || 'Thông báo') + '\n\n' + $('<div>').html(content || '').text());
			if(typeof options.onClose === 'function'){
				options.onClose();
			}
			return;
		}

		$.fancybox.open({
			src: $modal[0],
			type: 'inline',
			touch: false,
			smallBtn: false,
			toolbar: false,
			clickSlide: false,
			clickOutside: options.clickOutside !== false,
			animationEffect: 'fade',
			transitionEffect: 'fade',
			baseClass: 'fancybox-alert-wrap',
			afterClose: function(){
				if(typeof options.onClose === 'function'){
					options.onClose();
				}
			}
		});

		$modal.find('.fancybox-alert__btn').off('click.alertConfirm').on('click.alertConfirm', function(){
			if(typeof options.onConfirm === 'function'){
				options.onConfirm();
			}
		});
	},
	alertClose: function(callback){
		if(typeof $.fancybox !== 'undefined'){
			$.fancybox.close();
		}
		if(typeof callback === 'function'){
			return callback();
		}
	},
  mathLabelSale: function(number){
		var phanNguyen = Math.floor(number);
		var phanThapPhan = number - phanNguyen;
		if (phanThapPhan >= 0.5) {
			return Math.ceil(number);
		} 
		else {
			return Math.floor(number);
		}
	},
  validateEmail: function($email) {
		var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;
		return emailReg.test( $email );
	},
  getCartSidebar: function(callback){
    if (MLPRO.MiniCart && typeof MLPRO.MiniCart.refresh === 'function') {
      MLPRO.MiniCart.refresh(function () {
        MLPRO.MiniCart.open();
        if (typeof callback === 'function') {
          return callback();
        }
      });
      return;
    }
    if (typeof callback === 'function') {
      return callback();
    }
  },
  getCart: function(callback){
    $.get('/cart.js', function(data){
      cartJS = data;
      MLPRO.Module.cartJSItemInAdmin(function(){
        if(typeof callback === "function"){
  				return callback();
  			}
      });
    });
  },
  cartJSItemInAdmin: function(callback){
		var self = this;
		
		const promises = window.cartJS.items.map(item => {
			return new Promise((resolve, reject) => {
				$.ajax({
					type: "GET",
					url: item.url + ".js",
					success: function(data) {
						item.inAdmin = data;
						resolve();
					},
					error: function(error) {
						reject(error);
					}
				});
			});
		});
		
		Promise.all(promises)
			.then(() => {
			if(typeof callback === "function"){
				return callback();
			}
		}).catch(error => {

		});
  },
  validateEmail: function ($email) {
    var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;
    return emailReg.test($email);
  },
}
