var MLPRO = {}
MLPRO.Module = {
  findTokenVerification: function($form){
    var token = $form.find('input[name="__RequestVerificationToken"]').val();
    return token;
  },
  openLoading: function(callback){
    $('.loading-ovl').addClass('open');
    if(typeof callback === "function"){
      return callback();
    }
  },
  removeLoading: function(callback){
    $('.loading-ovl').removeClass('open');
    if(typeof callback === "function"){
      return callback();
    }
  },
	toastShow: function(mess){
		var $toast =  $('.toast');
		var textWarning = mess;
		$toast.find('.toast-body').text(textWarning);
		new bootstrap.Toast($toast[0]).show();
	},
  mathLabelSale: function(number){
		var phanNguyen = Math.floor(number);
		var phanThapPhan = number - phanNguyen;
		if (phanThapPhan >= 0.5) {
			return Math.ceil(number);
		} 
		else {
			return Math.floor(number);
		}
	},
  validateEmail: function($email) {
		var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;
		return emailReg.test( $email );
	},
  getCartSidebar: function(callback){
    $.get('/cart.js', function(data){
      cartJS = data;
      LEE.Module.cartJSItemInAdmin(function(){
        //LEE.SidebarCart.renderItem();
        $('body').addClass('open-sidebar-cart');
        if(typeof callback === "function"){
  				return callback();
  			}
      });
    });
  },
  getCart: function(callback){
    $.get('/cart.js', function(data){
      cartJS = data;
      LEE.Module.cartJSItemInAdmin(function(){
        if(typeof callback === "function"){
  				return callback();
  			}
      });
    });
  },
  cartJSItemInAdmin: function(callback){
		var self = this;
		
		const promises = window.cartJS.items.map(item => {
			return new Promise((resolve, reject) => {
				$.ajax({
					type: "GET",
					url: item.url + ".js",
					success: function(data) {
						item.inAdmin = data;
						resolve();
					},
					error: function(error) {
						reject(error);
					}
				});
			});
		});
		
		Promise.all(promises)
			.then(() => {
			if(typeof callback === "function"){
				return callback();
			}
		}).catch(error => {

		});
	},
}
MLPRO.Global = {
  init: function(){
    MLPRO.Header.init();
  }
}
MLPRO.Header = {
  init: function () {
    this.megaMenu();
    this.mobileToggle();
  },
  megaMenu: function () {
    var $header = $('.site-header');
    var $dropdownItem = $header.find('.site-header__item--dropdown');
    var $mega = $header.find('.site-header__mega');
    var closeTimer;

    if (!$dropdownItem.length || !$mega.length) {
      return;
    }

    function openMega(megaId) {
      clearTimeout(closeTimer);
      $header.addClass('is-mega-open');
      $dropdownItem.removeClass('is-active');
      $mega.removeClass('is-active');
      $dropdownItem.filter('[data-mega="' + megaId + '"]').addClass('is-active');
      $mega.filter('[data-mega="' + megaId + '"]').addClass('is-active');
    }

    function closeMega() {
      closeTimer = setTimeout(function () {
        $header.removeClass('is-mega-open');
        $dropdownItem.removeClass('is-active');
        $mega.removeClass('is-active');
      }, 80);
    }

    $dropdownItem.on('mouseenter focusin', function () {
      openMega($(this).data('mega'));
    });

    $mega.on('mouseenter', function () {
      openMega($(this).data('mega'));
    });

    $header.on('mouseleave', closeMega);

    $dropdownItem.on('focusout', function (e) {
      if (!$header[0].contains(e.relatedTarget)) {
        closeMega();
      }
    });
  },
  mobileToggle: function () {
    var $header = $('.site-header');
    var $toggle = $header.find('.site-header__toggle');
    var $mobileNav = $header.find('.site-header__mobile-nav');

    $toggle.on('click', function () {
      var isOpen = $mobileNav.hasClass('is-open');
      $mobileNav.toggleClass('is-open', !isOpen);
      $toggle.attr('aria-expanded', !isOpen);
      $('body').toggleClass('open-menu-mb', !isOpen);
    });
  }
}
MLPRO.Index = {
  init: function(){
    var that = this;
    that.productLoopSwiper();
    that.homeVideoPlay();
  },
  productLoopSwiper: function(){
    $('.product-loop__swiper').each(function(){
      var $swiperEl = $(this);
      var slideCount = $swiperEl.find('.swiper-slide').length;
      if(slideCount < 2){
        $swiperEl.find('.product-loop__nav').hide();
        return;
      }
      var swiper = new Swiper(this, {
        slidesPerView: 1,
        allowTouchMove: true,
        speed: 400,
        loop: true,
        navigation: {
          nextEl: $swiperEl.find('.product-loop__nav--next')[0],
          prevEl: $swiperEl.find('.product-loop__nav--prev')[0]
        }
      });
      $swiperEl.find('.product-loop__nav').on('click', function(e){
        e.preventDefault();
        e.stopPropagation();
      });
    });
  },
  homeVideoPlay: function(){
    $('.home-video__play').on('click', function(){
      var $media = $(this).closest('.home-video__media');
      var videoId = $media.data('youtube-id');
      if(!videoId || $media.hasClass('is-playing')){
        return;
      }
      var iframe = '<iframe src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen title="Video"></iframe>';
      $media.find('.home-video__iframe-wrap').html(iframe);
      $media.addClass('is-playing');
    });
  },
}
