                ${product.compare_at_price > product.price ? `<span class="product-loop__compare-price" data-compare-price="${product.compare_at_price}">
                ${Haravan.formatMoney(product.compare_at_price, shop.moneyFormat)}</span>` : ''}
              </div>
              <p class="product-loop__desc" data-description="${product.metadescription}">${product.metadescription.length > 80 ? product.metadescription.substring(0, 80) + '...' : product.metadescription}</p>
            </div>
          </a>
        </div>`;

        if (isSlider) {
