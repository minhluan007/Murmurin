*{margin: 0;padding: 0;-webkit-box-sizing: border-box;-moz-box-sizing: border-box;	box-sizing: border-box;}
html,body{border: 0;background-color: #fff;}
html{-webkit-overflow-scrolling: touch;-webkit-text-size-adjust:none;-ms-text-size-adjust:100%;}
html {
	height: -webkit-fill-available;
}
img{max-width:100%;}
.container {
  padding-right: 60px;
  padding-left: 60px;
  max-width: 1440px;
  @media(max-width: 1199px){
    padding-right: 16px;
    padding-left: 16px;
  }
}

.container-fluid {
  padding-right: 40px;
  padding-left: 40px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
body {
	font-family: var(--font-body);
  color: #222222;
	overflow-x: hidden;
	background: #ffffff;
	position: relative;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.4;
  &.open-menu-mb, &.fancybox-active {
    overflow: hidden;
  }
}
:after, :before {-webkit-box-sizing: border-box;-moz-box-sizing: border-box;	box-sizing: border-box;}
article, aside, details, figcaption, figure, dialog, footer, header, hgroup, menu, nav, section { display:block; }
h1,h2,h3,h4,h5,h6 {margin:0 0 13px 0;  font-weight: bold;line-height:1.2; font-family: var(--font-heading);}
img{max-width:100%;}
a {
	color:#2e2e2e;
	text-decoration: none; 
	outline: none;
	-moz-transition: none;
	-o-transition: none;
	-webkit-transition: none;
	transition: none;
}
a:hover,a:focus{color:#2e2e2e;text-decoration: none; outline: none;}	
a:active { outline: none; }
strong { font-weight: 700; }
em { font-style: italic; }
textarea{resize: none;}
ul, ol{	padding:0;margin:0;list-style-type:none;}
img {
	&.lazyload {opacity: 0;}
}
button, input, textarea {
	outline: none;
	box-shadow: none;
	border-radius: 0;
}
input[type="checkbox"], 
input[type="radio"] {
	margin-top: 0;
	vertical-align: top;
	width: 18px;
	height: 18px;
	-webkit-appearance: none;
	-moz-appearance: none;
	appearance: none;
	position: relative;
	margin: 0 5px 0 0;
	cursor: pointer;
	outline: 0 !important; 
	@media (max-width: 1199.98px){
		background: none;
		border: none; 
	}
	&:after{
		content: "";
		position: absolute;
		left: 0px;
		right: 0;
		bottom: 0;
		top: 0;
		margin: auto;
		width: 18px;
		height: 18px;
		background: #fff;
		border: 1px solid #C6CBD0;
		cursor: pointer;
	}
	&:before{
		-webkit-transition: -webkit-transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
		-moz-transition: -moz-transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
		transition: transform 0.4s cubic-bezier(0.45, 1.8, 0.5, 0.75);
		-webkit-transform: rotate(-45deg) scale(0, 0);
		-moz-transform: rotate(-45deg) scale(0, 0);
		-ms-transform: rotate(-45deg) scale(0, 0);
		-o-transform: rotate(-45deg) scale(0, 0);
		transform: rotate(-45deg) scale(0, 0);
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 5px;
		margin: auto;
		z-index: 1;
		width: 10px;
		height: 5px;
		border: 1px solid #fff;
		border-top-style: none;
		border-right-style: none;
	}
	&:checked{
		&:after{
			background-color: #2E2E2E;
			border-color: transparent;
		}
		&:before{
			-webkit-transform: rotate(-45deg) scale(1, 1);
			-moz-transform: rotate(-45deg) scale(1, 1);
			-ms-transform: rotate(-45deg) scale(1, 1);
			-o-transform: rotate(-45deg) scale(1, 1);
			transform: rotate(-45deg) scale(1, 1); 
		}
	}
}
.fix-style:not(.swiper-initialized) {
  .swiper-wrapper {
    display: grid;
    gap: 10px;
    &[item-gap-mb="5"] {
      @media(max-width: 991px){
        gap: 5px;
      }
    }
    &[item-show="1"] {
      grid-template-columns: repeat(1, 1fr);
      .swiper-slide:nth-child(n+2) { display: none; }
    }
    &[item-show="2"] {
      grid-template-columns: repeat(2, 1fr);
      .swiper-slide:nth-child(n+3) { display: none; }
    }
    &[item-show="3"] {
      grid-template-columns: repeat(3, 1fr);
      .swiper-slide:nth-child(n+4) { display: none; }
    }
    &[item-show="4"] {
      grid-template-columns: repeat(4, 1fr);
      .swiper-slide:nth-child(n+5) { display: none; }
    }
    &[item-show="5"] {
      grid-template-columns: repeat(5, 1fr);
      .swiper-slide:nth-child(n+6) { display: none; }
    }
    &[item-show-mb="2"] {
      @media(max-width: 991px){
        grid-template-columns: repeat(2, 1fr);
        .swiper-slide:nth-child(n+3) { display: none; }
      }
    }
    &[item-show-mb="1.2"] {
      @media(max-width: 991px){
        display: flex;
        overflow-x: hidden;
        .swiper-slide {
          flex: 0 0 83%;
          max-width: 83%;
        }
        .swiper-slide:nth-child(n+2) { display: block; }
        .swiper-slide:nth-child(n+3) { display: none; }
      }
    }
    &.no-product {
      grid-template-columns: auto;
    }
  }
}
.swiper-container {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.style-navigation-2 {
  position: relative;
  .btn-nav {
    margin-top: 0;
    top: 32%;
    color: gray;
    position: absolute;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1), inset 4px 4px 60px rgba(233, 233, 233, 0.2);
    opacity: 1;
    @media(max-width: 991px){
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.7);
      top: 26%;
    }
    &:after {
      font-size: 20px;
      @media(max-width: 991px){
        font-size: 18px;
      }
    }
  }
}
.style-navigation-4 {
  position: relative;
  .btn-nav {
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    -o-transform: translateY(-50%);
    color: gray;
    position: absolute;
    z-index: 1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    opacity: 1;
    @media(max-width: 991px){
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.7);
    }
    &:after {
      font-size: 20px;
      color: #fff;
      @media(max-width: 991px){
        font-size: 14px;
      }
    }
  }
  .group-swiper-button {
    // opacity: 0;
    // visibility: hidden;
    // transition: 0.3s all;
  }
  &:hover {
    .group-swiper-button {
      opacity: 1;
      visibility: visible;
    }
  }
}
.style-navigation-5 {
  position: relative;
  .btn-nav {
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    -ms-transform: translateY(-50%);
    -o-transform: translateY(-50%);
    color: gray;
    position: absolute;
    z-index: 1;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1), inset 4px 4px 60px rgba(233, 233, 233, 0.2);
    opacity: 1;
    @media(max-width: 991px){
      width: 40px;
      height: 40px;
      background: rgba(255, 255, 255, 0.7);
    }
    &:after {
      font-size: 20px;
      @media(max-width: 991px){
        font-size: 18px;
      }
    }
  }
}
.style-navigation-3 {
  @media(min-width: 992px){
    .swiper-button-prev {
      top: 0;
      &:after {
        font-size: 20px;
        transform: rotate(90deg);
      }
    }
    .swiper-button-next {
      top: auto;
      bottom: 0;
      &:after {
        font-size: 20px;
        transform: rotate(90deg);
      }
    }
    .btn-nav {
      background: transparent;
      border: none;
      outline: none;
      box-shadow: none;
      width: 100%;
      height: auto;
      transform: translateY(0%);
      -webkit-transform: translateY(0%);
      -ms-transform: translateY(0%);
      -o-transform: translateY(0%);
      left: 0;
    }
  }
}

.css-pagination-2 {
  .custom-sw-pagination {
    max-width: 80%;
    margin: 50px auto 0 auto;
    @media(max-width: 991px){
      max-width: none;
      margin: 20px 0 0 0;
    }
  }
  .swiper-pagination {
    position: relative;
    bottom: 0;
    width: 100%;
    display: flex;
    span {
      background: rgba(148, 148, 148, 0.2) !important;
      opacity: 1;
      flex: 1 1 0;
      width: 100%;
      height: 15px;
      display: inline-block;
      border-radius: 0;
      margin-left: 5px;
      margin-right: 5px;
      background: none;
      position: relative;
      height: 4px;
      &:hover, &.swiper-pagination-bullet-active {
        opacity: 1;
        background: rgba(0, 0, 0, 0.75) !important;
      }
    }
  }
}
.css-pagination {
  .custom-sw-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: absolute;
    bottom: 10px;
    z-index: 5;
    &.custom-sw-pagination-fix {
      width: 90%;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      margin: 0 auto;
    }
    @media(max-width: 991px){
      padding: 0 20px;
    }
  }
  .swiper-pagination {
    max-width: 400px;
    position: relative;
    bottom: 0;
    width: 100%;
    display: flex;
    span {
      opacity: .7;
      flex: 1 1 0;
      width: 100%;
      height: 15px;
      display: inline-block;
      border-radius: 0;
      margin-left: 5px;
      margin-right: 5px;
      background: none;
      position: relative;
      &:hover, &.swiper-pagination-bullet-active {
        opacity: 1;
      }
      &:after {
        content: "";
        display: block;
        border-top: 3px solid #fff;
        width: 100%;
        position: absolute;
        top: 50%;
        margin-top: -1.5px;
        left: 0;
        right: 0;
      }
    }
  }
}
.effect-loading {
  -webkit-animation: .45s linear infinite alternate skeletonAnimation;
  animation: .45s linear infinite alternate skeletonAnimation;
  will-change: opacity;
}
@keyframes line {
  0% {
    width: 0
  }
  to {
    width: 100%
  }
}

@keyframes out {
  0% {
    margin-left: 0;
    width: 100%
  }
  to {
    margin-left: 100%;
    width: 0
  }
}
@-webkit-keyframes skeletonAnimation {
  0% {
    opacity: .45
  }
  100% {
    opacity: .9
  }
}
@keyframes skeletonAnimation {
  0% {
    opacity: .45
  }
  100% {
    opacity: .9
  }
}
.loading-ovl{
	position: fixed;
	top:0;
	left:0;
	right:0;
	bottom:0;
	background: rgba(255,255,255,.75);
	z-index: 10000;
	display:flex;
	justify-content: center;
	align-items: center;
	visibility: hidden;
	opacity:0;
	&.open{
		visibility: visible;
		opacity:1;
	}
	.load-3 .line:nth-last-child(1) {animation: loadingC .6s .1s linear infinite;}
	.load-3 .line:nth-last-child(2) {animation: loadingC .6s .2s linear infinite;}
	.load-3 .line:nth-last-child(3) {animation: loadingC .6s .3s linear infinite;}
	.load-3{
		.line{
			display: inline-block;
			width: 15px;
			height: 15px;
			border-radius: 15px;
			background-color: #222;
		}
	}
}
@keyframes loadingC {
	0% {transform: translate(0,0);}
	50% {transform: translate(0,15px);}
	100% {transform: translate(0,0);}
}
.messenger-fb {
  position: fixed;
  bottom: 100px;
  right: 20px;
  z-index: 9;
  transition: 0.2s all;
  @media (max-width: 991px){
    bottom: 100px;
  }
  .toggle-sticky &{
    bottom: 180px;
    @media (max-width: 991px){
      bottom: 255px;
    }
  }
  img {
    width: 60px;
  }
}
#scrollToTop {
  position: fixed;
  bottom: 30px;
  right: 20px;
  padding: 10px 15px;
  background-color: #fff;
  color: #fff;
  border: none;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transition: 0.2s all;
  width: 60px;
  height: 60px;
  border: 1px solid #cacaca;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
  @media(max-width: 991px){
    bottom: 60;
  }
  .toggle-sticky & {
    bottom: 110px;
    @media(max-width: 991px){
      bottom: 185px;
    }
  }
  svg {
    width: 25px;
    height: 25px;
  }
  &.isShow {
    opacity: 1;
    visibility: visible;
  }
}
.toast {
	position: fixed;
	z-index: 999999;
	text-align: center;
	top: 4%;
	border: 0;
	width: 382px;
	padding: 0;
	color: #fff;
	right: 7%;
	box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	@media(max-width: 991.98px){
		top: 1%;
		width: 94%;
		right: 3%;
	}
	.toast-close {
		position: absolute;
		top: 10px;
		right: 8px;
	}
	&, & > div {
		background-color: #2e2e2e;
	}	

	&:not(.show) {
		pointer-events: none;
	}
	.close {
		outline: none;
		border: 0;
		background-color: unset;
		position: absolute;
		top: 20px;
		right: 20px;
	}
	.toast-body {
		font-size: 12px;
		text-transform: uppercase;
		text-align: left;
		border-radius: 4px;
		padding: 15px 16px;
	}
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.template-index {
  .wrap-main {
    padding-top: 0;
  }
}

/* HEADER */
.site-header {
  position: relative;
  width: 100%;
  z-index: 100;
  --header-height: 72px;
  --mega-height: 320px;

  &__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: #fff;
    transform: scaleY(0);
    transform-origin: top center;
    transition:
      transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      height 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
    z-index: 0;
    pointer-events: none;
    border-bottom: 1px solid #eee;
  }

  &__wrap {
    position: relative;
    z-index: 1;
  }

  &__bar {
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    gap: 32px;

    @media (max-width: 991px) {
      gap: 16px;
    }
  }

  &__logo {
    flex-shrink: 0;

    a {
      display: inline-block;
      line-height: 0;
    }

    img {
      display: block;
      width: auto;
      height: 40px;

      @media (max-width: 991px) {
        height: 32px;
      }
    }
  }

  &__nav {
    flex: 1;
    min-width: 0;

    @media (max-width: 991px) {
      display: none;
    }
  }

  &__menu {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  &__item {
    > a {
      display: block;
      padding: 24px 12px;
      @include font18;
      font-weight: 600;
      font-family: var(--font-heading);
      color: #000;
      letter-spacing: 0.04em;
      transition: color 0.25s ease;

      &:hover,
      &.is-active {
        color: #000;
      }
    }
  }

  &__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    margin-left: auto;
    flex-shrink: 0;
  }

  &__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000;
    position: relative;
    transition: color 0.25s ease;

    &--cart {
      .site-header__cart-count {
        position: absolute;
        top: -6px;
        right: -8px;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: #c8102e;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        line-height: 16px;
        text-align: center;
      }
    }
  }

  &__mega-wrap {
    position: relative;
  }

  &__mega {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
    transition:
      max-height 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.28s ease 0.06s,
      visibility 0s linear 0.45s;

    @media (max-width: 991px) {
      display: none;
    }
  }

  &__mega-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    padding-top: 36px;
    padding-bottom: 48px;
    transform: translateY(-16px);
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) 0.08s;
  }

  &__mega-links {
    flex-shrink: 0;
    width: 240px;

    ul {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    a {
      display: inline-block;
      @include font20;
      font-weight: 600;
      color: #000;
      font-family: var(--font-heading);
      position: relative;

      &:after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 0;
        height: 2px;
        background: #7b0c0c;
        transition: width 0.3s ease;
      }

      &:hover {
        color: #000;

        &:after {
          width: 100%;
        }
      }
    }
  }

  &__mega-cards {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    gap: 22px;
    flex: 1;
  }

  &__mega-card {
    position: relative;
    display: block;
    width: 42vw;
    max-width: 300px;
    aspect-ratio: 4 / 3;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s ease;
    }

    span {
      position: absolute;
      left: 18px;
      bottom: 18px;
      z-index: 2;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.04em;
      font-family: var(--font-heading);
    }

    &:before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background: rgba(0, 0, 0, 0.18);
    }

    &:hover {
      img {
        transform: scale(1.06);
      }
    }
  }

  &__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;

    @media (max-width: 991px) {
      display: flex;
    }

    span {
      display: block;
      width: 100%;
      height: 2px;
      background: #000;
      transition: transform 0.2s ease, opacity 0.2s ease, background 0.25s ease;
    }
  }

  &__mobile-nav {
    display: none;
    position: relative;
    z-index: 1;
    background: #fff;
    border-top: 1px solid #eee;

    @media (max-width: 991px) {
      &.is-open {
        display: block;
      }
    }

    > nav > ul {
      padding: 16px 0 24px;
    }

    a {
      display: block;
      padding: 10px 0;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: #000;
    }
  }

  &__mobile-sub {
    padding-left: 16px;
    margin-top: 4px;

    a {
      padding: 8px 0;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: #444;
    }
  }

  &:not(.site-header--overlay) {
    .site-header__backdrop {
      transform: scaleY(1);
    }
  }

  &--overlay {
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;

    .site-header__backdrop {
      height: calc(var(--header-height) + var(--mega-height));
      transform: scaleY(0);
    }

    .site-header__item > a,
    .site-header__action {
      color: #fff;
    }

    .site-header__toggle span {
      background: #fff;
    }
  }

  &.is-mega-open {
    .site-header__backdrop {
      transform: scaleY(1);
    }

    .site-header__mega-wrap {
      min-height: var(--mega-height);
    }

    .site-header__mega.is-active {
      position: relative;
      max-height: var(--mega-height);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        max-height 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
        opacity 0.28s ease 0.06s,
        visibility 0s linear 0s;
    }

    .site-header__mega.is-active .site-header__mega-inner {
      transform: translateY(0);
    }

    .site-header__item > a,
    .site-header__action {
      color: #000;
    }

    .site-header__toggle span {
      background: #000;
    }
  }

  &--overlay.is-mega-open {
    .site-header__item > a,
    .site-header__action {
      color: #000;
    }
  }

  &.is-mega-open:not(.site-header--overlay) {
    .site-header__backdrop {
      height: calc(var(--header-height) + var(--mega-height));
    }
  }
}

/* HOME HERO */
.home-hero {
  position: relative;
  overflow: hidden;
  background: #c8102e;
  min-height: 65svh;
  &__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 37.4183% 54.5885%;
    }
  }

  &__content {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    z-index: 1;
    transform: translateY(-50%);
    text-align: left;
    padding: 0;
  }

  &__title {
    margin: 0 0 0;
    @include font48;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;

    @media (max-width: 991px) {
      margin-bottom: 20px;
    }
  }

  &__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    @include font14;
    font-weight: 500;
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    padding-bottom: 4px;
    transition: opacity 0.2s ease;

    &:hover {
      color: #fff;
      opacity: 0.8;
    }
  }
}

/* HOME PRODUCTS */
.home-products {
  background: #fff;

  &__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;

    @media (max-width: 991px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 1px;
    }

    @media (max-width: 575px) {
      grid-template-columns: 1fr;
    }
  }
}

.product-loop {
  min-width: 0;
  background: #f1f1f1;
  &__link {
    display: block;
    color: inherit;

    &:hover {
      color: inherit;

      .product-loop__choose {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
    }
  }

  &__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #f3f3f3;
    overflow: hidden;
    margin-bottom: 0;
    width: 100%;

    &:hover {
      .product-loop__nav {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;

        &.swiper-button-disabled {
          opacity: 0.35;
          pointer-events: none;
        }
      }
    }
  }

  &__swiper {
    position: relative;
    width: 100%;
    height: 100%;

    .swiper-slide {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f3f3f3;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
    }
  }

  &__nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    cursor: pointer;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, background 0.2s ease;
    pointer-events: none;

    @media (max-width: 991px) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    &:hover {
      background: #fff;
    }

    &.swiper-button-disabled {
      opacity: 0.35;
      cursor: default;
      pointer-events: none;
    }

    &--prev {
      left: 12px;
    }

    &--next {
      right: 12px;
    }

    svg {
      display: block;
    }
  }

  &__placeholder {
    width: 100%;
    height: 100%;
    background: #f3f3f3;
  }

  &__choose {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 999px;
    background: #fff;
    @include font14;
    font-weight: 600;
    color: #000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    outline: 2px solid #cfcfcf;
    font-family: var(--font-heading);
    svg {
      width: 20px;
      height: 20px;
    }
  }

  &__info {
    padding: 12px;
  }

  &__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  &__title {
    margin: 0;
    @include font18;
    font-weight: 600;
    text-transform: uppercase;
  }

  &__price {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  &__desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #666;
  }

  &--placeholder {
    .product-loop__choose {
      display: none;
    }
  }
}

/* HOME VIDEO */
.home-video {
  &__inner {
    display: grid;
    grid-template-columns: 67% 33%;
    min-height: 520px;

    @media (max-width: 991px) {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }

  &__media {
    position: relative;
    overflow: hidden;
    background: #ddd;

    &.is-playing {
      .home-video__poster,
      .home-video__play {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .home-video__iframe-wrap {
        opacity: 1;
        visibility: visible;
      }
    }
  }

  &__poster {
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease, visibility 0.3s ease;

    @media (max-width: 991px) {
      min-height: 320px;
    }

    &--placeholder {
      background: linear-gradient(180deg, #d8d0c4 0%, #b8aea0 100%);
    }
  }

  &__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: 72px;
    height: 72px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.3s ease, visibility 0.3s ease;

    &:hover {
      transform: translate(-50%, -50%) scale(1.05);
    }

    @media (max-width: 991px) {
      width: 56px;
      height: 56px;
    }
  }

  &__iframe-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;

    iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
  }

  &__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 72px;
    background: #e5d9c8;

    @media (max-width: 1199px) {
      padding: 48px 40px;
    }

    @media (max-width: 991px) {
      padding: 40px 24px;
    }
  }

  &__title {
    margin: 0 0 24px;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: #000;
    text-transform: uppercase;
  }

  &__text {
    p {
      margin: 0;
      font-size: 15px;
      line-height: 1.7;
      color: #222;
    }
  }
}

/* FOOTER */
.site-footer {
  background: #f0f0f0;
  padding: 64px 0 32px;

  @media (max-width: 991px) {
    padding: 48px 0 24px;
  }

  &__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 64px;
    margin-bottom: 48px;

    @media (max-width: 991px) {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  &__links-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;

    @media (max-width: 575px) {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  &__col {
    &--newsletter {
      @media (min-width: 992px) {
        padding-left: 32px;
      }
    }
  }

  &__heading {
    margin: 0 0 20px;
    @include font24;
    font-weight: 600;
    color: #000;
    text-transform: uppercase;
  }

  &__links {
    li + li {
      margin-top: 10px;
    }

    a {
      font-size: 14px;
      color: #444;
      transition: color 0.2s ease;

      &:hover {
        color: #000;
      }
    }
  }

  &__newsletter {
    display: flex;
    align-items: center;
    border-bottom: 1px solid #999;
    padding-bottom: 8px;

    input {
      flex: 1;
      border: 0;
      background: transparent;
      font-size: 14px;
      color: #000;
      padding: 0;

      &::placeholder {
        color: #888;
      }
    }

    button {
      flex-shrink: 0;
      border: 0;
      background: transparent;
      color: #000;
      cursor: pointer;
      padding: 0 0 0 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  &__bottom {
    padding-top: 24px;

    p {
      margin: 0;
      font-size: 12px;
      color: #666;
    }
  }
}
