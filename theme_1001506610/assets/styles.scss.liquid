  &__nav-btn {
    width: 28px;
    height: 28px;
    border: 0;
    background: transparent;
    color: #999;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s ease;

    &:hover:not(.swiper-button-disabled) {
