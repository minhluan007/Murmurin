// fancybox MSO customer
.mso-signup {
  width: 100%;
  max-width: 550px;
  padding: 32px 30px;
  background: #fff;
  box-sizing: border-box;
  max-height: 650px;
  border-radius: 4px;
  &__inner {
    width: 100%;
  }

  &__tabs {
    display: flex;
    align-items: stretch;
    margin: 0 0 16px;
  }

  &__tab {
    flex: 1;
    padding: 0 0 12px;
    border: 0;
    border-bottom: 1px solid #e8e8e8;
    background: transparent;
    color: #9a9a9a;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
    box-shadow: none;

    &--active {
      color: #000;
      border-bottom: 3px solid #000;
    }
  }

  &__body {
    width: 100%;
  }

  &__panel {
    display: none;

    &.is-active {
      display: block;
    }
  }

  &__intro {
    margin: 0 0 16px;
    color: #333;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    text-align: center;
  }

  &__benefits {
    margin: 0 0 16px;
    color: #333;
    font-size: 14px;
    line-height: 22px;
    text-align: left;

    ul {
      margin: 8px 0 0;
      padding: 0 0 0 18px;
      list-style: inherit;
    }

    li {
      margin: 0 0 6px;
    }

    strong {
      font-weight: 700;
    }
  }

  &__form {
    width: 100%;
  }

  &__field {
    width: 100%;
    margin: 0 0 16px;
  }

  &__label {
    display: block;
    margin: 0 0 8px;
    color: #9a9a9a;
    font-size: 12px;
    // font-weight: 500;
    line-height: 16px;
    text-transform: uppercase;
  }

  &__input {
    width: 100%;
    height: 44px;
    padding: 12px 16px;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    background: #fff;
    color: #000;
    font-size: 14px;
    line-height: 20px;
    outline: none;
    box-shadow: none;
    box-sizing: border-box;

    &:focus {
      border-color: #bcbcbc;
    }

    &.is-invalid {
      border-color: #d32f2f;
    }
  }

  &__password {
    position: relative;

    .mso-signup__input {
      padding-right: 48px;
    }

    &.show-pass {
      .mso-signup__eye {
        svg {
          &:first-child {
            display: none;
          }

          &:last-child {
            display: block;
          }
        }
      }
    }
  }

  &__eye {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;

    svg {
      display: block;

      &:last-child {
        display: none;
      }
    }
  }

  &__error {
    display: none;
    margin: 6px 0 0;
    color: #d32f2f;
    font-size: 12px;
    line-height: 16px;

    &.is-show {
      display: block;
    }
  }

  &__hint {
    margin: 8px 0 0;
    color: #9a9a9a;
    font-size: 11px;
    line-height: 16px;
  }

  &__terms {
    margin: 0 0 20px;
    color: #787878;
    font-size: 13px;
    line-height: 20px;
    text-align: center;

    a {
      color: inherit;
      text-decoration: underline;
    }
  }

  &__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  &__status {
    display: none;
    width: 100%;
    margin: 0 0 12px;
    padding: 10px 12px;
    border-radius: 4px;
    font-size: 13px;
    line-height: 18px;
    text-align: center;

    &.is-show {
      display: block;
    }

    &--success {
      background: #e8f5e9;
      color: #2e7d32;
    }

    &--warning {
      background: #fff3e0;
      color: #ed6c02;
    }
  }

  &__submit {
    width: 100%;
    height: 48px;
    padding: 12px 32px;
    border: 0;
    border-radius: 4px;
    background: #000;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.2s,
      opacity 0.2s;

    &:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }
  }

  &__forgot-link {
    margin: 16px 0 0;
    color: #787878;
    font-size: 14px;
    line-height: 20px;
    text-decoration: underline;
    text-transform: uppercase;
  }

  &__divider {
    width: 100%;
    height: 1px;
    margin: 16px 0;
    background: #e8e8e8;
  }

  &__social {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  &__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 0;
    border-radius: 4px;
    background: #1877f2;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 22px;
    text-transform: uppercase;
    cursor: pointer;

    &--google {
      background: #4285f4;
    }

    &--facebook {
      background: #1877f2;

      .mso-signup__social-icon {
        border-radius: 50%;
      }
    }
  }

  &__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: 10px;
    border-radius: 4px;
    background: #fff;

    svg {
      display: block;
      width: 18px;
      height: 18px;
    }
  }

  @media (max-width: 991px) {
    max-width: 100%;
    padding: 24px 16px;

    &__tab {
      font-size: 14px;
    }

    &__intro,
    &__benefits {
      font-size: 13px;
      line-height: 20px;
    }

    &__submit {
      font-size: 14px;
    }

    &__social-btn {
      font-size: 13px;
    }
  }
}

.mini-cart {
  --mini-cart-accent: #a50d25;
  --mini-cart-accent-hover: #8a0b1f;
  position: fixed;
  inset: 0;
  z-index: 220;
  pointer-events: none;
  visibility: hidden;

  &.is-visible {
    visibility: visible;
  }

  &.is-open {
    pointer-events: auto;

    .mini-cart__overlay {
      opacity: 1;
    }

    .mini-cart__drawer {
      transform: translateX(0);
    }
  }

  &.is-loading {
    .mini-cart__drawer {
      pointer-events: none;

      &::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.45);
        z-index: 5;
      }
    }
  }

  &__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  &__drawer {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background: #fff;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
    overflow: hidden;
    will-change: transform;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.08);
  }

  &__state {
    display: none;
    flex-direction: column;
    height: 100%;
    min-height: 0;

    &.is-active {
      display: flex;
    }
  }

  &__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
