    }

    &.swiper-button-disabled {
      opacity: 0.35;
      cursor: default;
    }
  }

  &__products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px 16px;

    @media (max-width: 991.98px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    @media (max-width: 767.98px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
    }
  }

  &__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 28px 12px;
    color: #666;
    @include font14;
  }

  &__swiper {
    overflow: hidden;
    margin: 0;
  }

  &__footer {
    display: flex;
    justify-content: center;
    padding-top: 8px;

    &.is-hidden {
      display: none !important;
    }
  }

  &__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    height: 48px;
    padding: 0 28px;
